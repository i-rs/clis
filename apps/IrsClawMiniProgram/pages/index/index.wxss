/* ============================================================
 *  Chat Page · 主聊天页
 * ============================================================ */
.chat-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--bg);
  overflow: hidden;
  position: relative;
}

/* Ambient glow · 顶部径向光晕 */
.chat-page::before {
  content: '';
  position: fixed;
  top: 0; left: 0; right: 0;
  height: 50vh;
  pointer-events: none;
  z-index: 0;
  background:
    radial-gradient(ellipse 70% 50% at 30% 0%, var(--accent-bg-2) 0%, transparent 65%),
    radial-gradient(ellipse 50% 35% at 80% 0%, rgba(96, 165, 250, 0.04) 0%, transparent 50%);
}
.light .chat-page::before {
  background:
    radial-gradient(ellipse 70% 50% at 30% 0%, rgba(108, 92, 231, 0.05) 0%, transparent 65%),
    radial-gradient(ellipse 50% 35% at 80% 0%, rgba(37, 99, 235, 0.03) 0%, transparent 50%);
}

/* ── Navbar (override) ── */
.navbar {
  display: flex;
  align-items: center;
  padding: 12rpx 20rpx;
  padding-top: calc(12rpx + env(safe-area-inset-top));
  background: transparent;
  flex-shrink: 0;
  z-index: 10;
  position: relative;
}
.nav-btn {
  width: 72rpx; height: 72rpx; border-radius: 22rpx;
  display: flex; align-items: center; justify-content: center;
  background: var(--surface);
  border: 1rpx solid var(--border);
  box-shadow: var(--shadow-sm), var(--highlight);
  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
}
.nav-btn:active { transform: scale(0.92); background: var(--surface-2); }
.nav-btn-icon { font-size: 36rpx; color: var(--text); font-weight: 400; }
.nav-center { flex: 1; text-align: center; min-width: 0; }
.nav-title {
  font-size: 30rpx; font-weight: 700; color: var(--text);
  letter-spacing: -0.5rpx;
}

/* ── Scroll ── */
.messages-scroll {
  flex: 1; overflow: hidden; overflow-x: hidden;
  position: relative; z-index: 1;
}
.msg-bottom-anchor { height: 24rpx; }

/* ============================================================
 *  Empty State · 空状态(精致 hero)
 * ============================================================ */
.empty-state {
  display: flex; flex-direction: column; align-items: center;
  padding: 140rpx 60rpx 80rpx; text-align: center;
  min-height: 70vh; position: relative; z-index: 1;
}
.empty-logo {
  width: 144rpx; height: 144rpx; border-radius: 40rpx;
  background: linear-gradient(135deg, var(--accent) 0%, var(--accent-2) 50%, var(--accent-3) 100%);
  display: flex; align-items: center; justify-content: center;
  margin-bottom: 40rpx;
  box-shadow:
    0 12rpx 32rpx rgba(139, 124, 247, 0.40),
    0 0 0 1rpx rgba(255, 255, 255, 0.08) inset,
    0 2rpx 4rpx rgba(255, 255, 255, 0.20) inset;
  position: relative;
  animation: float 4s ease-in-out infinite;
}
.empty-logo::after {
  content: '';
  position: absolute; inset: -8rpx;
  border-radius: 48rpx;
  background: linear-gradient(135deg, var(--accent), var(--accent-2));
  opacity: 0.25; z-index: -1;
  filter: blur(20rpx);
}
.empty-logo-text {
  font-size: 56rpx; font-weight: 700; color: #fff;
  letter-spacing: 1rpx;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.20);
}
.empty-title {
  font-size: 44rpx; font-weight: 700; color: var(--text);
  margin-bottom: 16rpx; letter-spacing: -1rpx;
  background: linear-gradient(135deg, var(--text) 0%, var(--text-2) 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}
.empty-desc {
  font-size: 28rpx; color: var(--text-2);
  margin-bottom: 60rpx; letter-spacing: 0.3rpx;
}
.suggestions {
  display: flex; flex-wrap: wrap; gap: 16rpx;
  justify-content: center; max-width: 620rpx;
}
.suggest-btn {
  padding: 18rpx 32rpx;
  background: var(--surface);
  border: 1rpx solid var(--border);
  border-radius: var(--r-full);
  transition: all 0.2s;
  box-shadow: var(--shadow-sm), var(--highlight);
}
.suggest-btn:active {
  background: var(--accent-bg);
  border-color: var(--accent);
  transform: scale(0.96);
}
.suggest-text { font-size: 26rpx; color: var(--text-2); font-weight: 500; }

@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-6rpx); }
}

/* ============================================================
 *  Message List
 * ============================================================ */
.message-list { padding: 24rpx 24rpx 0; }
.msg-row {
  display: flex; align-items: flex-start; margin-bottom: 28rpx;
  gap: 16rpx; width: 100%; box-sizing: border-box;
  animation: fadeInUp 0.32s cubic-bezier(0.16, 1, 0.3, 1);
}
.msg-row-user { flex-direction: row-reverse; }
.msg-row-ai { flex-direction: row; }

/* ── Avatar ── */
.avatar {
  width: 72rpx; height: 72rpx; border-radius: var(--r-md);
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0; margin-top: 4rpx;
  box-shadow: var(--shadow-sm), var(--highlight);
  position: relative;
}
.avatar-user { background: linear-gradient(135deg, #EC4899 0%, #F472B6 100%); }
.avatar-ai {
  background: linear-gradient(135deg, var(--accent) 0%, var(--accent-2) 100%);
}
.avatar-tool {
  background: linear-gradient(135deg, var(--orange) 0%, #FB923C 100%);
}
.avatar-text {
  font-size: 24rpx; font-weight: 700; color: #fff;
  letter-spacing: 0.5rpx; text-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.15);
}

/* ── Message Content ── */
.msg-content { max-width: 75%; min-width: 0; flex-shrink: 1; }
.msg-content-user { display: flex; flex-direction: column; align-items: flex-end; }
.msg-content-ai {
  display: flex; flex-direction: column; align-items: flex-start;
  max-width: 75%; min-width: 0; overflow: hidden;
}

/* ============================================================
 *  Message Bubbles · 统一圆角(无尾巴)· 与卡片系统协调
 * ============================================================ */
.msg-bubble {
  padding: 22rpx 28rpx;
  word-break: break-word; overflow-wrap: anywhere;
  max-width: 100%; box-sizing: border-box;
  line-height: 1.65;
  border-radius: var(--r-md);
}
.msg-bubble-user {
  background: linear-gradient(135deg, var(--user-bg-start) 0%, var(--user-bg-end) 100%);
  box-shadow:
    0 4rpx 16rpx rgba(139, 124, 247, 0.30),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.20);
  color: var(--user-text);
}
.msg-bubble-ai {
  background: var(--ai-bg);
  border: 1rpx solid var(--border);
  box-shadow: var(--shadow-sm), var(--highlight);
}
.msg-text {
  font-size: 30rpx; line-height: 1.7;
  word-break: break-word; overflow-wrap: anywhere;
  letter-spacing: 0.1rpx;
}
.msg-text-user { color: var(--user-text); }
.msg-text-ai { color: var(--ai-text); }

/* ============================================================
 *  Thinking Card
 * ============================================================ */
.thinking-card {
  background: var(--surface);
  border: 1rpx solid var(--border);
  border-radius: var(--r-md);
  overflow: hidden;
  width: 100%;
  max-width: 600rpx;
  box-sizing: border-box;
  box-shadow: var(--shadow-sm), var(--highlight);
  transition: border-color 0.2s;
}
.thinking-card:active { border-color: var(--border-focus); }
.thinking-header {
  display: flex; align-items: center; padding: 18rpx 24rpx;
  gap: 14rpx; height: 76rpx; box-sizing: border-box;
  width: 100%; overflow: hidden; flex-shrink: 0;
}
.thinking-icon-wrap {
  width: 40rpx; height: 40rpx; border-radius: var(--r-xs);
  background: var(--accent-bg);
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
  box-shadow: var(--highlight);
}
.thinking-icon { font-size: 24rpx; color: var(--accent); line-height: 1; }
.thinking-label {
  font-size: 28rpx; font-weight: 600; color: var(--text);
  flex-shrink: 0; max-width: 200rpx;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  line-height: 1.2; letter-spacing: -0.2rpx;
}
.thinking-count {
  font-size: 22rpx; color: var(--text-3);
  flex-shrink: 0; margin-left: auto;
  line-height: 1.2; padding-left: 8rpx;
  font-family: ui-monospace, "SF Mono", Menlo, monospace;
}
/* CSS-drawn chevron (chevron-right) */
.chev {
  width: 14rpx; height: 14rpx; flex-shrink: 0;
  border-right: 3rpx solid var(--text-3);
  border-bottom: 3rpx solid var(--text-3);
  transform: rotate(-45deg) translateY(-2rpx);
  margin-left: 6rpx;
  transition: transform 0.32s cubic-bezier(0.34, 1.4, 0.64, 1), border-color 0.2s;
  display: inline-block;
}
.chev.open {
  transform: rotate(45deg) translateY(-2rpx);
  border-color: var(--accent);
}
.thinking-chevron,
.tool-chevron,
.reasoning-fold-chevron { display: none; }
.thinking-body {
  padding: 22rpx 24rpx; border-top: 1rpx solid var(--border);
  width: 100%; overflow: hidden;
}
.thinking-text {
  font-size: 26rpx; color: var(--text-2); line-height: 1.7;
  white-space: pre-wrap; word-break: break-all;
}

/* ============================================================
 *  Tool Call Card · 与思考卡统一几何
 * ============================================================ */
.tool-card {
  background: var(--surface);
  border: 1rpx solid var(--border);
  border-radius: var(--r-md);
  overflow: hidden;
  width: 100%;
  max-width: 600rpx;
  box-sizing: border-box;
  box-shadow: var(--shadow-sm), var(--highlight);
  transition: border-color 0.2s;
}
.tool-card-error {
  border-color: rgba(248, 113, 113, 0.30);
  background: linear-gradient(180deg, var(--surface) 0%, var(--red-bg) 200rpx);
}
.tool-card:active { border-color: var(--border-focus); }
.tool-header {
  display: flex; align-items: center; padding: 18rpx 24rpx;
  gap: 14rpx; height: 76rpx; box-sizing: border-box;
  width: 100%; overflow: hidden; flex-shrink: 0;
}
.tool-status {
  width: 40rpx; height: 40rpx; border-radius: var(--r-xs);
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0; box-shadow: var(--highlight);
}
.tool-status-running { background: var(--orange-bg); }
.tool-status-done { background: var(--green-bg); }
.tool-status-error { background: var(--red-bg); }
.tool-status-icon { font-size: 24rpx; font-weight: 700; line-height: 1; }
.tool-status-running .tool-status-icon {
  color: var(--orange); animation: spin 1.2s linear infinite; display: inline-block;
}
.tool-status-done .tool-status-icon { color: var(--green); }
.tool-status-error .tool-status-icon { color: var(--red); }
.tool-name {
  font-size: 28rpx; font-weight: 600; color: var(--text);
  flex-shrink: 0; max-width: 200rpx;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  line-height: 1.2; letter-spacing: -0.2rpx;
}
.tool-name-error { color: var(--red); }
.tool-preview {
  font-size: 22rpx; color: var(--text-3);
  flex: 1 1 0; overflow: hidden; text-overflow: ellipsis;
  white-space: nowrap; text-align: right;
  min-width: 0; margin-left: auto; padding-left: 8rpx;
  line-height: 1.2;
  font-family: ui-monospace, "SF Mono", Menlo, monospace;
}
.tool-preview-error { color: var(--red); }
.tool-body {
  padding: 22rpx 24rpx; border-top: 1rpx solid var(--border);
  width: 100%; overflow: hidden;
}
.tool-section { margin-bottom: 18rpx; }
.tool-section:last-child { margin-bottom: 0; }
.tool-section-label {
  font-size: 22rpx; color: var(--text-3);
  font-weight: 600; display: block; margin-bottom: 10rpx;
  letter-spacing: 1rpx; text-transform: uppercase;
}
.tool-code-wrap {
  background: var(--bg);
  border-radius: var(--r-sm);
  padding: 16rpx 18rpx;
  max-width: 100%; overflow-x: auto;
  box-sizing: border-box;
  border: 1rpx solid var(--border);
}
.tool-code {
  font-size: 24rpx; color: var(--text-2);
  line-height: 1.7; white-space: pre-wrap;
  word-break: break-all; max-width: 100%;
  font-family: ui-monospace, "SF Mono", Menlo, monospace;
}
.tool-code-error {
  color: var(--red);
  background: var(--red-bg);
}

/* ============================================================
 *  Reasoning Fold
 * ============================================================ */
.reasoning-fold {
  background: var(--surface);
  border: 1rpx solid var(--border);
  border-radius: var(--r-md);
  margin-bottom: 16rpx;
  overflow: hidden;
  width: 100%;
  max-width: 600rpx;
  box-sizing: border-box;
  box-shadow: var(--shadow-sm), var(--highlight);
  transition: border-color 0.2s;
}
.reasoning-fold:active { border-color: var(--border-focus); }
.reasoning-fold-header {
  display: flex; align-items: center; padding: 18rpx 24rpx;
  gap: 14rpx; height: 76rpx; box-sizing: border-box;
  width: 100%; overflow: hidden; flex-shrink: 0;
}
.reasoning-fold-icon {
  font-size: 24rpx; color: var(--text-3);
  flex-shrink: 0; line-height: 1;
  width: 40rpx; height: 40rpx;
  display: flex; align-items: center; justify-content: center;
  background: var(--surface-2); border-radius: var(--r-xs);
  box-shadow: var(--highlight);
}
.reasoning-fold-label {
  font-size: 28rpx; font-weight: 600; color: var(--text);
  flex-shrink: 0; max-width: 200rpx;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  line-height: 1.2; letter-spacing: -0.2rpx;
}
.reasoning-fold-count {
  font-size: 22rpx; color: var(--text-3);
  flex-shrink: 0; margin-left: auto;
  line-height: 1.2; padding-left: 8rpx;
  font-family: ui-monospace, "SF Mono", Menlo, monospace;
}
.reasoning-fold-body {
  padding: 22rpx 24rpx; border-top: 1rpx solid var(--border);
  width: 100%; overflow: hidden;
}
.reasoning-fold-text {
  font-size: 26rpx; color: var(--text-2); line-height: 1.7;
  white-space: pre-wrap; word-break: break-all;
}

/* ============================================================
 *  Thinking Dots · 与气泡几何统一
 * ============================================================ */
.thinking-dots {
  display: flex; align-items: center; gap: 12rpx;
  padding: 26rpx 28rpx;
  background: var(--ai-bg);
  border: 1rpx solid var(--border);
  border-radius: var(--r-md);
  box-shadow: var(--shadow-sm), var(--highlight);
}
.dot {
  width: 14rpx; height: 14rpx; border-radius: 50%;
  background: var(--text-3);
  animation: dotBounce 1.4s ease-in-out infinite both;
}
.dot-1 { animation-delay: 0s; }
.dot-2 { animation-delay: 0.16s; }
.dot-3 { animation-delay: 0.32s; }

/* ============================================================
 *  Collapsible Animations
 * ============================================================ */
.thinking-body, .tool-body, .reasoning-fold-body {
  max-height: 0; opacity: 0; overflow: hidden;
  padding: 0;
  border-top-width: 0;
  box-sizing: border-box;
  transition: max-height 0.32s cubic-bezier(0.16, 1, 0.3, 1),
              opacity 0.24s ease,
              padding 0.32s cubic-bezier(0.16, 1, 0.3, 1),
              border-top-width 0.32s ease;
}
.thinking-body.expanded,
.tool-body.expanded,
.reasoning-fold-body.expanded {
  max-height: 2000rpx;
  opacity: 1;
  padding: 22rpx 24rpx;
  border-top-width: 1rpx;
}

.thinking-chevron, .tool-chevron, .reasoning-fold-chevron {
  display: none;
}

/* ============================================================
 *  Connection Bar
 * ============================================================ */
.conn-bar {
  display: flex; align-items: center; gap: 12rpx;
  padding: 16rpx 32rpx;
  background: var(--orange-bg);
  font-size: 24rpx; color: var(--orange);
  border-top: 1rpx solid rgba(251, 191, 36, 0.20);
  flex-shrink: 0;
}
.conn-dot {
  width: 12rpx; height: 12rpx; border-radius: 50%;
  background: var(--orange);
  box-shadow: 0 0 0 4rpx rgba(251, 191, 36, 0.20);
  animation: pulse 2s ease-in-out infinite;
}
.conn-text { flex: 1; font-weight: 500; }
.conn-action {
  padding: 6rpx 20rpx;
  background: var(--orange); color: #fff;
  border-radius: var(--r-full);
  font-size: 22rpx; font-weight: 600;
  transition: opacity 0.15s;
}
.conn-action:active { opacity: 0.75; }

/* ============================================================
 *  Input Bar
 * ============================================================ */
.input-bar-wrap {
  flex-shrink: 0;
  padding: 0 24rpx 24rpx;
  position: relative; z-index: 5;
}
.input-bar {
  background: var(--surface);
  border: 1rpx solid var(--border);
  border-radius: var(--r-md);
  transition: border-color 0.2s, box-shadow 0.2s, background 0.2s;
  box-shadow: var(--shadow-md), var(--highlight);
}
.input-bar:focus-within {
  border-color: var(--border-focus);
  box-shadow: var(--shadow-md), var(--shadow-glow);
  background: var(--surface-2);
}
.input-bar-inner {
  display: flex; align-items: center;
  gap: 8rpx; padding: 12rpx 12rpx 12rpx 12rpx;
}
.input-menu-btn {
  width: 60rpx; height: 60rpx; border-radius: var(--r-md);
  flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
  transition: background 0.18s;
}
.input-menu-btn:active { background: var(--surface-2); }
.input-menu-icon { font-size: 30rpx; color: var(--text-2); }
.input-text {
  flex: 1; font-size: 30rpx; color: var(--text);
  height: 72rpx; line-height: 72rpx;
  background: transparent; padding: 0; border: none;
}
.ph { color: var(--text-3); font-size: 30rpx; line-height: 72rpx; }
.input-send {
  width: 72rpx; height: 72rpx; border-radius: var(--r-full);
  flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
  background: var(--surface-2);
  transition: all 0.28s cubic-bezier(0.34, 1.56, 0.64, 1);
}
.input-send-on {
  background: linear-gradient(135deg, var(--accent) 0%, var(--accent-2) 100%);
  box-shadow: 0 4rpx 20rpx rgba(139, 124, 247, 0.40),
              inset 0 1rpx 0 rgba(255, 255, 255, 0.25);
}
.input-send-on:active { transform: scale(0.88); }
.input-send-icon {
  font-size: 32rpx; font-weight: 700; color: var(--text-3);
  transition: color 0.25s, transform 0.25s;
}
.input-send-on .input-send-icon { color: #fff; transform: translateY(-1rpx); }

/* ============================================================
 *  Sidebar
 * ============================================================ */
.sidebar-mask {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.55); z-index: 100;
  opacity: 0; visibility: hidden;
  transition: opacity 0.32s ease, backdrop-filter 0.32s ease;
  -webkit-backdrop-filter: blur(0rpx); backdrop-filter: blur(0rpx);
}
.sidebar-mask-show {
  opacity: 1; visibility: visible;
  -webkit-backdrop-filter: blur(12rpx); backdrop-filter: blur(12rpx);
}

.sidebar {
  position: fixed; top: 0; left: 0; bottom: 0;
  width: 600rpx;
  background: var(--surface);
  z-index: 101;
  transform: translate3d(-100%, 0, 0);
  transition: transform 0.42s cubic-bezier(0.16, 1, 0.3, 1),
              box-shadow 0.42s ease;
  display: flex; flex-direction: column;
  border-right: 1rpx solid var(--border);
  box-shadow: 0 0 0 rgba(0, 0, 0, 0);
  will-change: transform;
  box-shadow: var(--highlight);
}
.sidebar-open {
  transform: translate3d(0, 0, 0) !important;
  box-shadow: 16rpx 0 48rpx rgba(0, 0, 0, 0.20), var(--highlight);
}
.sidebar-touching { transition: none !important; }

/* Brand Header */
.sidebar-header {
  display: flex; align-items: center; justify-content: space-between;
  padding: 40rpx 32rpx 32rpx;
  padding-top: calc(40rpx + env(safe-area-inset-top));
  border-bottom: 1rpx solid var(--border);
  position: relative;
}
.sidebar-header::after {
  content: '';
  position: absolute; left: 32rpx; right: 32rpx; bottom: 0;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, var(--border-strong), transparent);
}
.sidebar-brand { display: flex; align-items: center; gap: 20rpx; flex: 1; min-width: 0; }
.sidebar-logo {
  width: 80rpx; height: 80rpx; border-radius: 22rpx;
  background: linear-gradient(135deg, var(--accent) 0%, var(--accent-2) 50%, var(--accent-3) 100%);
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 6rpx 20rpx rgba(139, 124, 247, 0.40),
              inset 0 1rpx 0 rgba(255, 255, 255, 0.25);
  flex-shrink: 0;
}
.sidebar-logo-text { font-size: 30rpx; font-weight: 700; color: #fff; letter-spacing: 1rpx; }
.sidebar-brand-text { display: flex; flex-direction: column; gap: 4rpx; min-width: 0; }
.sidebar-title {
  font-size: 32rpx; font-weight: 700; color: var(--text);
  letter-spacing: -0.5rpx;
}
.sidebar-subtitle {
  font-size: 22rpx; color: var(--text-3); letter-spacing: 1rpx;
  text-transform: uppercase;
}
.sidebar-close {
  width: 60rpx; height: 60rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  background: var(--surface-2);
  border: 1rpx solid var(--border);
  transition: all 0.18s; flex-shrink: 0;
  box-shadow: var(--highlight);
}
.sidebar-close-hover { background: var(--surface-3); transform: scale(0.92); }
.sidebar-close-icon { font-size: 40rpx; line-height: 1; color: var(--text-2); font-weight: 300; }

/* Current Session Card */
.sidebar-session {
  margin: 24rpx 28rpx 16rpx;
  padding: 20rpx 24rpx 20rpx 28rpx;
  background: var(--surface-2);
  border-radius: var(--r-md);
  border: 1rpx solid var(--border);
  position: relative; overflow: hidden;
  box-shadow: var(--highlight);
}
.sidebar-session::before {
  content: '';
  position: absolute; left: 0; top: 16rpx; bottom: 16rpx;
  width: 6rpx;
  background: linear-gradient(180deg, var(--accent), var(--accent-2));
  border-radius: 0 6rpx 6rpx 0;
  box-shadow: 0 0 12rpx var(--accent-glow);
}
.sidebar-session-label {
  font-size: 20rpx; color: var(--text-3);
  margin-bottom: 6rpx; letter-spacing: 1.5rpx;
  text-transform: uppercase; font-weight: 600;
}
.sidebar-session-row { display: flex; align-items: center; gap: 10rpx; min-width: 0; }
.sidebar-session-title {
  font-size: 28rpx; font-weight: 600; color: var(--text);
  flex: 1; min-width: 0;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  letter-spacing: -0.2rpx;
}
.sidebar-session-tag {
  padding: 4rpx 14rpx;
  background: var(--accent);
  border-radius: var(--r-full);
  flex-shrink: 0; max-width: 200rpx;
  box-shadow: 0 2rpx 8rpx var(--accent-glow);
}
.sidebar-session-tag-text {
  font-size: 20rpx; color: #fff; font-weight: 600;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  display: block; line-height: 1.4; letter-spacing: 0.3rpx;
}

/* Nav */
.sidebar-nav { flex: 1; padding: 8rpx 0 16rpx; }
.sidebar-section { padding: 8rpx 0; }
.sidebar-section-label {
  display: block; padding: 16rpx 44rpx 12rpx;
  font-size: 20rpx; font-weight: 600; color: var(--text-3);
  letter-spacing: 2rpx; text-transform: uppercase;
}
.sidebar-item {
  display: flex; align-items: center;
  padding: 24rpx 32rpx; gap: 20rpx;
  margin: 0 16rpx; border-radius: var(--r-md);
  transition: background 0.18s, transform 0.18s;
  position: relative;
}
.sidebar-item-hover { background: var(--surface-2); transform: scale(0.98); }
.sidebar-item:active { transform: scale(0.97); }
.sidebar-item-icon-wrap {
  width: 60rpx; height: 60rpx; border-radius: var(--r-md);
  display: flex; align-items: center; justify-content: center;
  background: var(--surface-2);
  flex-shrink: 0;
  transition: background 0.18s;
  box-shadow: var(--highlight);
}
.sidebar-item-icon-accent {
  background: linear-gradient(135deg, var(--accent-bg), var(--accent-bg-2));
  box-shadow: 0 4rpx 12rpx var(--accent-glow), var(--highlight);
}
.sidebar-item-icon { font-size: 32rpx; line-height: 1; }
.sidebar-item-text {
  font-size: 30rpx; font-weight: 500; color: var(--text);
  flex: 1; letter-spacing: -0.2rpx;
}
.sidebar-item-shortcut {
  font-size: 20rpx; color: var(--text-3);
  padding: 4rpx 10rpx; border-radius: 6rpx;
  background: var(--surface-2);
  font-family: ui-monospace, "SF Mono", Menlo, monospace;
  font-weight: 600;
  border: 1rpx solid var(--border);
}

.sidebar-item-accent {
  background: linear-gradient(135deg, var(--accent-bg), var(--accent-bg-2));
  border: 1rpx solid var(--accent);
  margin: 0 16rpx 8rpx;
  box-shadow: 0 4rpx 16rpx rgba(139, 124, 247, 0.15), var(--highlight);
}

/* Footer Status */
.sidebar-footer {
  padding: 16rpx 32rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--border);
  background: var(--surface-2);
  position: relative;
}
.sidebar-footer::before {
  content: '';
  position: absolute; left: 32rpx; right: 32rpx; top: 0;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, var(--border-strong), transparent);
}
.sidebar-status { display: flex; flex-direction: column; }
.sidebar-conn-row { display: flex; align-items: center; gap: 12rpx; padding: 4rpx 0; }
.sidebar-conn-dot-wrap {
  position: relative; width: 22rpx; height: 22rpx; flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
}
.sidebar-conn-dot {
  width: 12rpx; height: 12rpx; border-radius: 50%;
  background: var(--red);
  position: relative; z-index: 2;
  box-shadow: 0 0 0 3rpx var(--red-bg);
}
.sidebar-conn-dot-ok { background: var(--green); box-shadow: 0 0 0 3rpx var(--green-bg); }
.sidebar-conn-dot-pulse {
  position: absolute; width: 12rpx; height: 12rpx;
  border-radius: 50%; background: var(--red); opacity: 0;
}
.sidebar-conn-dot-pulse-ok { background: var(--green); animation: sidebar-pulse 1.8s ease-out infinite; }
@keyframes sidebar-pulse {
  0% { transform: scale(1); opacity: 0.7; }
  100% { transform: scale(2.6); opacity: 0; }
}
.sidebar-conn-info {
  display: flex; flex-direction: row; align-items: center;
  gap: 10rpx; flex: 1; min-width: 0;
}
.sidebar-conn-text {
  font-size: 24rpx; font-weight: 600; color: var(--text);
  flex-shrink: 0; letter-spacing: 0.2rpx;
}
.sidebar-conn-url {
  font-size: 20rpx; color: var(--text-3);
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  font-family: ui-monospace, "SF Mono", Menlo, monospace;
  min-width: 0; flex: 1;
}
