.chat-page { display: flex; flex-direction: column; height: 100vh; background: var(--bg); overflow: hidden; }

/* Navbar */
.navbar { display: flex; align-items: center; padding: 16rpx 24rpx; padding-top: calc(16rpx + env(safe-area-inset-top)); background: transparent; flex-shrink: 0; z-index: 10; }
.nav-btn { width: 72rpx; height: 72rpx; border-radius: 20rpx; display: flex; align-items: center; justify-content: center; }
.nav-btn:active { background: var(--surface-2); }
.nav-btn-icon { font-size: 36rpx; color: var(--text); }
.nav-center { flex: 1; text-align: center; }
.nav-title { font-size: 34rpx; font-weight: 700; color: var(--text); }

/* Scroll */
.messages-scroll { flex: 1; overflow: hidden; overflow-x: hidden; }
.msg-bottom-anchor { height: 24rpx; }

/* Empty */
.empty-state { display: flex; flex-direction: column; align-items: center; padding: 160rpx 60rpx 80rpx; text-align: center; min-height: 70vh; }
.empty-logo { width: 120rpx; height: 120rpx; border-radius: 36rpx; background: linear-gradient(135deg, #6C5CE7, #A29BFE); display: flex; align-items: center; justify-content: center; margin-bottom: 36rpx; box-shadow: 0 8rpx 32rpx rgba(108, 92, 231, 0.3); }
.empty-logo-text { font-size: 44rpx; font-weight: 700; color: #fff; }
.empty-title { font-size: 38rpx; font-weight: 700; color: var(--text); margin-bottom: 12rpx; }
.empty-desc { font-size: 28rpx; color: var(--text-2); margin-bottom: 60rpx; }
.suggestions { display: flex; flex-wrap: wrap; gap: 20rpx; justify-content: center; max-width: 600rpx; }
.suggest-btn { padding: 18rpx 32rpx; background: var(--surface); border: 1rpx solid var(--border); border-radius: 40rpx; }
.suggest-btn:active { background: var(--accent-bg); border-color: var(--accent); }
.suggest-text { font-size: 26rpx; color: var(--text-2); }

/* Message List */
.message-list { padding: 24rpx 24rpx 0; }
.msg-row { display: flex; align-items: flex-start; margin-bottom: 24rpx; gap: 16rpx; width: 100%; box-sizing: border-box; }
.msg-row-user { flex-direction: row-reverse; }
.msg-row-ai { flex-direction: row; }

/* Avatar */
.avatar { width: 72rpx; height: 72rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0; margin-top: 4rpx; }
.avatar-user { background: linear-gradient(135deg, #6C5CE7, #8B7CF7); }
.avatar-ai { background: linear-gradient(135deg, #6C5CE7, #74B9FF); }
.avatar-tool { background: linear-gradient(135deg, #FFB347, #FF6B6B); }
.avatar-text { font-size: 24rpx; font-weight: 700; color: #fff; }

/* Message Content */
.msg-content { max-width: 75%; min-width: 0; flex-shrink: 1; }
.msg-content-user { display: flex; flex-direction: column; align-items: flex-end; }
.msg-content-ai { display: flex; flex-direction: column; align-items: flex-start; max-width: 75%; min-width: 0; overflow: hidden; }

/* Bubbles */
.msg-bubble { padding: 20rpx 28rpx; word-break: break-word; overflow-wrap: anywhere; max-width: 100%; box-sizing: border-box; }
.msg-bubble-user { background: linear-gradient(135deg, #6C5CE7, #7C6CF7); border-radius: 24rpx 8rpx 24rpx 24rpx; box-shadow: 0 4rpx 20rpx rgba(108, 92, 231, 0.25); }
.msg-bubble-ai { background: var(--ai-bg); border: 1rpx solid var(--border); border-radius: 8rpx 24rpx 24rpx 24rpx; }
.msg-text { font-size: 30rpx; line-height: 1.7; word-break: break-word; overflow-wrap: anywhere; }
.msg-text-user { color: #fff; }
.msg-text-ai { color: var(--ai-text); }

/* ===== Thinking Card (reasoning only, no content) ===== */
.thinking-card { background: var(--surface); border: 1rpx solid var(--border); border-radius: 20rpx; overflow: hidden; max-width: 100%; width: fit-content; min-width: 280rpx; max-width: 520rpx; box-sizing: border-box; }
.thinking-card:active { background: var(--surface-2); }
.thinking-header { display: flex; align-items: center; padding: 18rpx 24rpx; gap: 12rpx; height: 76rpx; box-sizing: border-box; max-width: 100%; width: 100%; overflow: hidden; flex-shrink: 0; }
.thinking-icon-wrap { width: 32rpx; height: 32rpx; border-radius: 50%; background: var(--accent-bg); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.thinking-icon { font-size: 22rpx; color: var(--accent); line-height: 1; }
.thinking-label { font-size: 28rpx; font-weight: 600; color: var(--text); flex-shrink: 0; max-width: 240rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; line-height: 1.2; }
.thinking-count { font-size: 24rpx; color: var(--text-3); flex-shrink: 0; margin-left: auto; line-height: 1.2; padding-left: 16rpx; }
.thinking-chevron { font-size: 24rpx; color: var(--text-3); flex-shrink: 0; width: 28rpx; height: 28rpx; line-height: 28rpx; text-align: center; transform-origin: 50% 50%; }
.thinking-body { padding: 22rpx 24rpx; border-top: 1rpx solid var(--border); max-width: 100%; overflow: hidden; }
.thinking-text { font-size: 28rpx; color: var(--text-2); line-height: 1.65; white-space: pre-wrap; word-break: break-all; }

/* ===== Tool Call Card ===== */
.tool-card { background: var(--surface); border: 1rpx solid var(--border); border-radius: 20rpx; overflow: hidden; max-width: 100%; width: fit-content; min-width: 280rpx; max-width: 520rpx; box-sizing: border-box; }
.tool-card-error { border-color: rgba(255, 107, 107, 0.2); }
.tool-card:active { background: var(--surface-2); }
.tool-header { display: flex; align-items: center; padding: 18rpx 24rpx; gap: 12rpx; height: 76rpx; box-sizing: border-box; max-width: 100%; width: 100%; overflow: hidden; flex-shrink: 0; }
.tool-status { width: 32rpx; height: 32rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.tool-status-running { background: var(--orange-bg); }
.tool-status-done { background: var(--green-bg); }
.tool-status-error { background: rgba(255, 107, 107, 0.15); }
.tool-status-icon { font-size: 22rpx; font-weight: 700; line-height: 1; }
.tool-status-spin { color: var(--orange); animation: spin 1s linear infinite; display: inline-block; }
.tool-status-done .tool-status-icon { color: var(--green); }
.tool-status-error .tool-status-icon { color: rgba(255, 107, 107, 0.75); }
.tool-name { font-size: 28rpx; font-weight: 600; color: var(--text); flex-shrink: 0; max-width: 240rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; line-height: 1.2; }
.tool-name-error { color: rgba(255, 107, 107, 0.85); }
.tool-preview { font-size: 24rpx; color: var(--text-3); flex: 1 1 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; text-align: right; min-width: 0; margin-left: auto; padding-left: 16rpx; line-height: 1.2; }
.tool-preview-error { color: rgba(255, 107, 107, 0.75); }
.tool-chevron { font-size: 24rpx; color: var(--text-3); flex-shrink: 0; width: 28rpx; height: 28rpx; line-height: 28rpx; text-align: center; transform-origin: 50% 50%; }
.tool-body { padding: 22rpx 24rpx; border-top: 1rpx solid var(--border); max-width: 100%; overflow: hidden; }
.tool-section { margin-bottom: 18rpx; }
.tool-section:last-child { margin-bottom: 0; }
.tool-section-label { font-size: 26rpx; color: var(--text-3); font-weight: 600; display: block; margin-bottom: 10rpx; }
.tool-code-wrap { background: var(--bg); border-radius: 12rpx; padding: 16rpx 18rpx; max-width: 100%; overflow-x: auto; box-sizing: border-box; }
.tool-code { font-size: 26rpx; color: var(--text-2); line-height: 1.65; white-space: pre-wrap; word-break: break-all; max-width: 100%; }
.tool-code-error { color: rgba(255, 107, 107, 0.85); background: rgba(255, 107, 107, 0.05); }

/* ===== Reasoning Fold (in AI message with content) ===== */
.reasoning-fold { background: var(--surface); border: 1rpx solid var(--border); border-radius: 20rpx; margin-bottom: 16rpx; overflow: hidden; max-width: 100%; width: fit-content; min-width: 280rpx; max-width: 520rpx; box-sizing: border-box; }
.reasoning-fold:active { background: var(--surface-2); }
.reasoning-fold-header { display: flex; align-items: center; padding: 18rpx 24rpx; gap: 12rpx; height: 76rpx; box-sizing: border-box; max-width: 100%; width: 100%; overflow: hidden; flex-shrink: 0; }
.reasoning-fold-icon { font-size: 22rpx; color: var(--text-3); flex-shrink: 0; line-height: 1; }
.reasoning-fold-label { font-size: 28rpx; font-weight: 600; color: var(--text); flex-shrink: 0; max-width: 240rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; line-height: 1.2; }
.reasoning-fold-count { font-size: 24rpx; color: var(--text-3); flex-shrink: 0; margin-left: auto; line-height: 1.2; padding-left: 16rpx; }
.reasoning-fold-chevron { font-size: 24rpx; color: var(--text-3); flex-shrink: 0; width: 28rpx; height: 28rpx; line-height: 28rpx; text-align: center; transform-origin: 50% 50%; }
.reasoning-fold-body { padding: 22rpx 24rpx; border-top: 1rpx solid var(--border); max-width: 100%; overflow: hidden; }
.reasoning-fold-text { font-size: 28rpx; color: var(--text-2); line-height: 1.65; white-space: pre-wrap; word-break: break-all; }

/* Thinking Dots */
.thinking-dots { display: flex; align-items: center; gap: 12rpx; padding: 24rpx 28rpx; background: var(--ai-bg); border: 1rpx solid var(--border); border-radius: 8rpx 24rpx 24rpx 24rpx; }
.dot { width: 16rpx; height: 16rpx; border-radius: 50%; background: var(--text-3); animation: dotBounce 1.4s ease-in-out infinite both; }
.dot-1 { animation-delay: 0s; }
.dot-2 { animation-delay: 0.16s; }
.dot-3 { animation-delay: 0.32s; }

/* ===== Collapsible Animations ===== */
@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}
@keyframes dotBounce {
  0%, 80%, 100% { transform: scale(0.6); opacity: 0.5; }
  40% { transform: scale(1); opacity: 1; }
}

.thinking-body, .tool-body, .reasoning-fold-body {
  max-height: 0;
  opacity: 0;
  overflow: hidden;
  padding-top: 0;
  padding-bottom: 0;
  border-top-width: 0;
  transition: max-height 0.3s cubic-bezier(0.34, 1.2, 0.64, 1),
              opacity 0.25s ease,
              padding 0.3s cubic-bezier(0.34, 1.2, 0.64, 1),
              border-top-width 0.3s ease;
}
.thinking-body.expanded,
.tool-body.expanded,
.reasoning-fold-body.expanded {
  max-height: 2000rpx;
  opacity: 1;
}

.thinking-chevron, .tool-chevron, .reasoning-fold-chevron {
  display: inline-block;
  transition: transform 0.3s cubic-bezier(0.34, 1.4, 0.64, 1);
}
.tool-chevron-anim.expanded,
.reasoning-fold-chevron-anim.expanded {
  transform: rotate(90deg);
}

/* Connection */
.conn-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 32rpx;
  background: var(--orange-bg);
  font-size: 24rpx;
  color: var(--orange);
}
.conn-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--orange);
}
.conn-text { flex: 1; }
.conn-action {
  padding: 6rpx 20rpx;
  background: var(--orange);
  color: #fff;
  border-radius: 16rpx;
  font-size: 22rpx;
  font-weight: 600;
}
.conn-action:active { opacity: 0.7; }

/* Input Bar */
.input-bar-wrap { flex-shrink: 0; padding: 0 32rpx 40rpx; }
.input-bar {
  background: var(--surface);
  border: 1rpx solid var(--border);
  border-radius: 24rpx;
  transition: border-color 0.2s, box-shadow 0.2s;
}
.input-bar:focus-within {
  border-color: var(--accent);
  box-shadow: 0 0 0 2rpx var(--accent-bg);
}
.input-bar-inner {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 12rpx 12rpx 16rpx;
}
.input-menu-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 14rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background 0.2s;
}
.input-menu-btn:active { background: var(--surface-2); }
.input-menu-icon { font-size: 28rpx; color: var(--text-3); }
.input-text {
  flex: 1;
  font-size: 30rpx;
  color: var(--text);
  height: 72rpx;
  line-height: 72rpx;
  background: transparent;
  padding: 0;
  border: none;
}
.ph { color: var(--text-3); font-size: 30rpx; line-height: 72rpx; }
.input-send {
  width: 72rpx;
  height: 72rpx;
  border-radius: 40rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--surface-2);
  transition: all 0.25s cubic-bezier(0.34,1.56,0.64,1);
}
.input-send-on {
  background: linear-gradient(135deg, #6C5CE7, #8B7CF7);
  box-shadow: 0 4rpx 20rpx rgba(108, 92, 231, 0.35);
}
.input-send-on:active { transform: scale(0.88); opacity: 0.85; }
.input-send-icon {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-3);
  transition: color 0.25s;
}
.input-send-on .input-send-icon { color: #fff; }

/* Sidebar */
.sidebar-mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0, 0, 0, 0.55); z-index: 100; opacity: 0; visibility: hidden; transition: opacity 0.32s ease, backdrop-filter 0.32s ease; -webkit-backdrop-filter: blur(0rpx); backdrop-filter: blur(0rpx); }
.sidebar-mask-show { opacity: 1; visibility: visible; -webkit-backdrop-filter: blur(8rpx); backdrop-filter: blur(8rpx); }

.sidebar { position: fixed; top: 0; left: 0; bottom: 0; width: 600rpx; background: var(--surface); z-index: 101; transform: translate3d(-100%, 0, 0); transition: transform 0.42s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.42s ease; display: flex; flex-direction: column; border-right: 1rpx solid var(--border); box-shadow: 0 0 0 rgba(0, 0, 0, 0); will-change: transform; }
.sidebar-open { transform: translate3d(0, 0, 0) !important; box-shadow: 12rpx 0 48rpx rgba(0, 0, 0, 0.18); }
.sidebar-touching { transition: none !important; }
/* Brand Header */
.sidebar-header { display: flex; align-items: center; justify-content: space-between; padding: 40rpx 32rpx 28rpx; padding-top: calc(40rpx + env(safe-area-inset-top)); border-bottom: 1rpx solid var(--border); }
.sidebar-brand { display: flex; align-items: center; gap: 20rpx; flex: 1; min-width: 0; }
.sidebar-logo { width: 80rpx; height: 80rpx; border-radius: 24rpx; background: linear-gradient(135deg, #6C5CE7, #A29BFE); display: flex; align-items: center; justify-content: center; box-shadow: 0 6rpx 20rpx rgba(108, 92, 231, 0.35); flex-shrink: 0; }
.sidebar-logo-text { font-size: 32rpx; font-weight: 700; color: #fff; letter-spacing: 1rpx; }
.sidebar-brand-text { display: flex; flex-direction: column; gap: 4rpx; min-width: 0; }
.sidebar-title { font-size: 32rpx; font-weight: 700; color: var(--text); letter-spacing: 0.5rpx; }
.sidebar-subtitle { font-size: 22rpx; color: var(--text-3); letter-spacing: 1rpx; }
.sidebar-close { width: 64rpx; height: 64rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: var(--surface-2); transition: background 0.2s, transform 0.2s; flex-shrink: 0; }
.sidebar-close-hover { background: var(--border); transform: scale(0.92); }
.sidebar-close-icon { font-size: 44rpx; line-height: 1; color: var(--text-2); font-weight: 300; }

/* Current Session Card */
.sidebar-session { margin: 20rpx 28rpx 12rpx; padding: 18rpx 22rpx 18rpx 26rpx; background: var(--surface-2); border-radius: 18rpx; border: 1rpx solid var(--border); position: relative; overflow: hidden; }
.sidebar-session::before { content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 6rpx; background: linear-gradient(180deg, var(--accent), #A29BFE); border-radius: 0 6rpx 6rpx 0; }
.sidebar-session-label { font-size: 20rpx; color: var(--text-3); margin-bottom: 6rpx; letter-spacing: 1rpx; }
.sidebar-session-row { display: flex; align-items: center; gap: 10rpx; min-width: 0; }
.sidebar-session-title { font-size: 26rpx; font-weight: 600; color: var(--text); flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.sidebar-session-tag { padding: 2rpx 12rpx; background: var(--accent); border-radius: 10rpx; flex-shrink: 0; max-width: 180rpx; overflow: hidden; }
.sidebar-session-tag-text { font-size: 20rpx; color: #fff; font-weight: 500; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; display: block; line-height: 1.4; }

/* Nav */
.sidebar-nav { flex: 1; padding: 8rpx 0 16rpx; }
.sidebar-section { padding: 8rpx 0; }
.sidebar-section-label { display: block; padding: 16rpx 44rpx 12rpx; font-size: 22rpx; font-weight: 600; color: var(--text-3); letter-spacing: 2rpx; text-transform: uppercase; }

.sidebar-item { display: flex; align-items: center; padding: 24rpx 32rpx; gap: 20rpx; margin: 0 16rpx; border-radius: 18rpx; transition: background 0.2s, transform 0.2s; position: relative; }
.sidebar-item-hover { background: var(--surface-2); transform: scale(0.98); }
.sidebar-item:active { transform: scale(0.97); }
.sidebar-item-icon-wrap { width: 56rpx; height: 56rpx; border-radius: 16rpx; display: flex; align-items: center; justify-content: center; background: var(--surface-2); flex-shrink: 0; transition: background 0.2s; }
.sidebar-item-icon-accent { background: linear-gradient(135deg, rgba(108, 92, 231, 0.18), rgba(162, 155, 254, 0.18)); }
.sidebar-item-icon { font-size: 32rpx; line-height: 1; }
.sidebar-item-text { font-size: 30rpx; font-weight: 500; color: var(--text); flex: 1; }
.sidebar-item-shortcut { font-size: 22rpx; color: var(--text-3); padding: 4rpx 12rpx; border-radius: 8rpx; background: var(--surface-2); font-family: -apple-system, monospace; }

.sidebar-item-accent { background: linear-gradient(135deg, rgba(108, 92, 231, 0.08), rgba(162, 155, 254, 0.04)); border: 1rpx solid rgba(108, 92, 231, 0.18); }

/* Footer Status */
.sidebar-footer { padding: 14rpx 32rpx; padding-bottom: calc(14rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid var(--border); background: var(--surface-2); }
.sidebar-status { display: flex; flex-direction: column; }
.sidebar-conn-row { display: flex; align-items: center; gap: 12rpx; padding: 4rpx 0; }
.sidebar-conn-dot-wrap { position: relative; width: 22rpx; height: 22rpx; flex-shrink: 0; display: flex; align-items: center; justify-content: center; }
.sidebar-conn-dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: var(--red); position: relative; z-index: 2; }
.sidebar-conn-dot-ok { background: var(--green); box-shadow: 0 0 0 4rpx rgba(46, 204, 113, 0.18); }
.sidebar-conn-dot-pulse { position: absolute; width: 12rpx; height: 12rpx; border-radius: 50%; background: var(--red); opacity: 0; }
.sidebar-conn-dot-pulse-ok { background: var(--green); animation: sidebar-pulse 1.8s ease-out infinite; }
@keyframes sidebar-pulse { 0% { transform: scale(1); opacity: 0.6; } 100% { transform: scale(2.4); opacity: 0; } }
.sidebar-conn-info { display: flex; flex-direction: row; align-items: center; gap: 10rpx; flex: 1; min-width: 0; }
.sidebar-conn-text { font-size: 22rpx; font-weight: 600; color: var(--text); flex-shrink: 0; }
.sidebar-conn-url { font-size: 20rpx; color: var(--text-3); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-family: -apple-system, monospace; min-width: 0; }