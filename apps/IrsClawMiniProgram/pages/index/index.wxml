<view class="chat-page">
  <!-- Messages -->
  <scroll-view class="messages-scroll" scroll-y scroll-into-view="{{scrollTarget}}" scroll-with-animation>
    <!-- Empty -->
    <view class="empty-state" wx:if="{{messages.length === 0 && !loading}}">
      <view class="empty-logo"><text class="empty-logo-text">AI</text></view>
      <text class="empty-title">开始对话</text>
      <text class="empty-desc">与 AI 助理交流</text>
      <view class="suggestions">
        <view class="suggest-btn" bindtap="onSuggest" data-text="帮我总结今天的数据"><text class="suggest-text">总结今天的数据</text></view>
        <view class="suggest-btn" bindtap="onSuggest" data-text="查看我的待办事项"><text class="suggest-text">查看待办事项</text></view>
        <view class="suggest-btn" bindtap="onSuggest" data-text="今天心情怎么样"><text class="suggest-text">记录心情</text></view>
      </view>
    </view>

    <!-- Messages List -->
    <view class="message-list" wx:if="{{messages.length > 0}}">
      <view wx:for="{{messages}}" wx:key="id" id="msg-{{item.id}}">

        <!-- ===== User Message ===== -->
        <view class="msg-row msg-row-user" wx:if="{{item.role === 'user'}}">
          <view class="avatar avatar-user"><text class="avatar-text">U</text></view>
          <view class="msg-content msg-content-user">
            <view class="msg-bubble msg-bubble-user">
              <text class="msg-text msg-text-user">{{item.content}}</text>
            </view>
          </view>
        </view>

        <!-- ===== AI Thinking (reasoning only, no content) ===== -->
        <view class="msg-row msg-row-ai" wx:if="{{item.role === 'assistant' && item.reasoning && !item.content}}">
          <view class="avatar avatar-ai"><text class="avatar-text">AI</text></view>
          <view class="msg-content msg-content-ai">
            <view class="thinking-card" bindtap="onToggleReasoning" data-id="{{item.id}}">
              <view class="thinking-header">
                <view class="thinking-icon-wrap">
                  <text class="thinking-icon">◈</text>
                </view>
                <text class="thinking-label">Thinking</text>
                <text class="thinking-count">{{item.reasoningCount}}</text>
                <text class="thinking-chevron {{item.reasoningExpanded ? 'expanded' : 'collapsed'}}">▶</text>
              </view>
              <view class="thinking-body {{item.reasoningExpanded ? 'expanded' : 'collapsed'}}">
                <text class="thinking-text">{{item.reasoning}}</text>
              </view>
            </view>
          </view>
        </view>

        <!-- ===== Tool Call ===== -->
        <view class="msg-row msg-row-ai" wx:if="{{item.role === 'tool_call'}}">
          <view class="avatar avatar-tool"><text class="avatar-text">⚙</text></view>
          <view class="msg-content msg-content-ai">
            <view class="tool-card {{(item.status === 'error' || item.error) ? 'tool-card-error' : ''}}" bindtap="onToggleTool" data-id="{{item.id}}">
              <view class="tool-header">
                <view class="tool-status {{(item.status === 'error' || item.error) ? 'tool-status-error' : (item.result ? 'tool-status-done' : 'tool-status-running')}}">
                  <view class="tool-status-icon">{{(item.status === 'error' || item.error) ? '✕' : (item.result ? '✓' : '↻')}}</view>
                </view>
                <text class="tool-name {{(item.status === 'error' || item.error) ? 'tool-name-error' : ''}}">{{item.name || '未知工具'}}</text>
                <text class="tool-preview {{(item.status === 'error' || item.error) ? 'tool-preview-error' : ''}}" wx:if="{{!item.expanded && (item.result || item.error)}}">{{item.error ? item.error : item.preview}}</text>
                <view class="chev {{item.expanded ? 'open' : ''}}"></view>
              </view>
              <view class="tool-body {{item.expanded ? 'expanded' : 'collapsed'}}">
                <view class="tool-section" wx:if="{{item.args}}">
                  <text class="tool-section-label">参数</text>
                  <view class="tool-code-wrap"><text class="tool-code">{{item.args}}</text></view>
                </view>
                <view class="tool-section" wx:if="{{item.result && !item.error}}">
                  <text class="tool-section-label">结果</text>
                  <view class="tool-code-wrap"><text class="tool-code">{{item.result}}</text></view>
                </view>
                <view class="tool-section" wx:if="{{item.error}}">
                  <text class="tool-section-label">错误</text>
                  <view class="tool-code-wrap"><text class="tool-code tool-code-error">{{item.error}}</text></view>
                </view>
              </view>
            </view>
          </view>
        </view>

        <!-- ===== AI Message (with content) ===== -->
        <view class="msg-row msg-row-ai" wx:if="{{item.role === 'assistant' && item.content}}">
          <view class="avatar avatar-ai"><text class="avatar-text">AI</text></view>
          <view class="msg-content msg-content-ai">
            <view class="reasoning-fold" wx:if="{{item.reasoning}}" bindtap="onToggleReasoning" data-id="{{item.id}}">
              <view class="reasoning-fold-header">
                <text class="reasoning-fold-icon">◈</text>
                <text class="reasoning-fold-label">Reasoning</text>
                <text class="reasoning-fold-count">{{item.reasoningCount}}</text>
                <view class="chev {{item.reasoningExpanded ? 'open' : ''}}"></view>
              </view>
              <view class="reasoning-fold-body {{item.reasoningExpanded ? 'expanded' : 'collapsed'}}">
                <text class="reasoning-fold-text">{{item.reasoning}}</text>
              </view>
            </view>
            <view class="msg-bubble msg-bubble-ai">
              <text class="msg-text msg-text-ai">{{item.content}}</text>
            </view>
            <view class="msg-token-usage" wx:if="{{item.tokenUsage}}">
              <text class="msg-token-text">↑{{item.tokenUsage.prompt_tokens || 0}} ↓{{item.tokenUsage.completion_tokens || 0}}</text>
              <text class="msg-cost-text" wx:if="{{item.tokenUsage.estimated_cost_usd}}">${{item.tokenUsage.estimated_cost_usd}}</text>
            </view>
            <view class="msg-feedback" wx:if="{{!item.feedbackGiven}}">
              <view class="feedback-btn feedback-like" bindtap="onFeedback" data-id="{{item.id}}" data-positive="true">
                <text class="feedback-icon">👍</text>
              </view>
              <view class="feedback-btn feedback-dislike" bindtap="onFeedback" data-id="{{item.id}}" data-positive="false">
                <text class="feedback-icon">👎</text>
              </view>
            </view>
          </view>
        </view>

        <!-- ===== Image Generated ===== -->
        <view class="msg-row msg-row-ai" wx:if="{{item.role === 'image'}}">
          <view class="avatar avatar-ai"><text class="avatar-text">AI</text></view>
          <view class="msg-content msg-content-ai">
            <view class="img-card">
              <image class="img-msg" src="{{item.url}}" mode="widthFix" lazy-load show-menu-by-longpress="{{true}}" wx:if="{{item.url}}" />
              <text class="img-caption" wx:if="{{item.altText}}">{{item.altText}}</text>
            </view>
          </view>
        </view>

        <!-- ===== Quality Score ===== -->
        <view class="msg-row msg-row-ai" wx:if="{{item.role === 'quality'}}">
          <view class="avatar avatar-ai"><text class="avatar-text">AI</text></view>
          <view class="msg-content msg-content-ai">
            <view class="quality-card">
              <view class="quality-header">
                <text class="quality-label">回答质量</text>
                <text class="quality-score {{item.score >= 0.7 ? 'quality-score-high' : (item.score >= 0.4 ? 'quality-score-mid' : 'quality-score-low')}}">{{item.scorePct || '—'}}</text>
              </view>
              <view class="quality-details" wx:if="{{item.issues && item.issues.length > 0}}">
                <view wx:for="{{item.issues}}" wx:key="*this" wx:for-item="iss">
                  <text class="quality-issue">• {{iss}}</text>
                </view>
              </view>
              <view class="quality-validity" wx:if="{{item.referencesValid > 0}}">
                <text class="quality-valid-text">✓ 引用有效 ({{item.referencesValid}})</text>
              </view>
              <view class="quality-validity" wx:if="{{!item.complete}}">
                <text class="quality-warn-text">⚠ 回答可能不完整</text>
              </view>
            </view>
          </view>
        </view>

        <!-- ===== Evaluation ===== -->
        <view class="msg-row msg-row-ai" wx:if="{{item.role === 'evaluation'}}">
          <view class="avatar avatar-tool"><text class="avatar-text">◉</text></view>
          <view class="msg-content msg-content-ai">
            <view class="eval-card {{item.valid ? '' : 'eval-card-invalid'}}">
              <view class="eval-header">
                <text class="eval-icon">{{item.valid ? '✓' : '✗'}}</text>
                <text class="eval-tool">工具: {{item.tool}}</text>
                <text class="eval-badge {{item.valid ? 'eval-badge-ok' : 'eval-badge-fail'}}">{{item.valid ? '有效' : '问题'}}</text>
              </view>
              <view class="eval-issues" wx:if="{{item.issues && item.issues.length > 0}}">
                <view wx:for="{{item.issues}}" wx:key="*this" wx:for-item="iss">
                  <text class="eval-issue">• {{iss}}</text>
                </view>
              </view>
            </view>
          </view>
        </view>
      </view>

      <!-- Streaming -->
      <view class="msg-row msg-row-ai" wx:if="{{loading || streamingContent || streamingReasoning || renderTick}}">
        <view class="avatar avatar-ai"><text class="avatar-text">AI</text></view>
        <view class="msg-content msg-content-ai">
          <view class="reasoning-fold" wx:if="{{streamingReasoning}}">
            <view class="reasoning-fold-header">
              <text class="reasoning-fold-icon">◈</text>
                <text class="reasoning-fold-label">Thinking...</text>
                <view class="chev open"></view>
            </view>
            <view class="reasoning-fold-body">
              <text class="reasoning-fold-text">{{streamingReasoning}}</text>
            </view>
          </view>
          <view class="msg-bubble msg-bubble-ai" wx:if="{{streamingContent}}">
            <text class="msg-text msg-text-ai">{{streamingContent}}</text>
          </view>
          <view class="thinking-dots" wx:if="{{loading && !streamingContent && !streamingReasoning}}">
            <view class="dot dot-1"></view>
            <view class="dot dot-2"></view>
            <view class="dot dot-3"></view>
          </view>
        </view>
      </view>

      <view id="msg-bottom" class="msg-bottom-anchor"></view>
    </view>
  </scroll-view>

  <!-- Connection -->
  <view class="conn-bar" wx:if="{{!isConnected}}">
    <text class="conn-dot"></text>
    <text class="conn-text">{{noServer ? '未配置服务器' : '未连接到服务器'}}</text>
    <view class="conn-action" wx:if="{{noServer}}" bindtap="onGoSettings">
      <text>去设置</text>
    </view>
  </view>

  <!-- Input Bar -->
  <view class="input-bar-wrap">
    <view class="input-bar">
      <view class="input-bar-inner">
        <view class="input-menu-btn" bindtap="onToggleMenu">
          <text class="input-menu-icon">☰</text>
        </view>
        <input class="input-text" value="{{inputText}}" placeholder="输入消息..." placeholder-class="ph" bindinput="onInput" bindfocus="onInputFocus" bindblur="onInputBlur" bindconfirm="onSend" confirm-type="send" maxlength="-1" cursor-spacing="20" />
        <view class="input-send {{inputText.length > 0 ? 'input-send-on' : ''}}" bindtap="onSend">
          <text class="input-send-icon">↑</text>
        </view>
      </view>
      <view style="height: env(safe-area-inset-bottom);"></view>
    </view>
  </view>

  <!-- Sidebar -->
  <view class="sidebar-mask {{menuOpen ? 'sidebar-mask-show' : ''}}" bindtap="onCloseMenu" catchtouchmove="onMaskMove"></view>
  <view class="sidebar {{menuOpen ? 'sidebar-open' : ''}} {{sidebarTouching ? 'sidebar-touching' : ''}}"
        bindtouchstart="onSidebarTouchStart"
        bindtouchmove="onSidebarTouchMove"
        bindtouchend="onSidebarTouchEnd"
        style="transform: translate3d({{menuOpen ? (sidebarOffsetX + 'rpx') : '-100%'}}, 0, 0);">

    <!-- Brand Header -->
    <view class="sidebar-header">
      <view class="sidebar-brand">
        <view class="sidebar-logo"><text class="sidebar-logo-text">AI</text></view>
        <view class="sidebar-brand-text">
          <text class="sidebar-title">i-rs-claw</text>
          <text class="sidebar-subtitle">智能助手</text>
        </view>
      </view>
      <view class="sidebar-close" hover-class="sidebar-close-hover" bindtap="onCloseMenu">
        <text class="sidebar-close-icon">×</text>
      </view>
    </view>

    <!-- Current Session Card -->
    <view class="sidebar-session" wx:if="{{sessionId}}">
      <view class="sidebar-session-label">当前会话</view>
      <view class="sidebar-session-row">
        <text class="sidebar-session-title">{{sessionTitle || '新对话'}}</text>
        <view class="sidebar-session-tag" wx:if="{{currentAgent && currentAgent !== 'default'}}">
          <text class="sidebar-session-tag-text">{{currentAgent}}</text>
        </view>
      </view>
    </view>

    <!-- Nav -->
    <scroll-view class="sidebar-nav" scroll-y enhanced show-scrollbar="{{false}}">
      <view class="sidebar-section">
        <text class="sidebar-section-label">快捷</text>
        <view class="sidebar-item sidebar-item-accent" hover-class="sidebar-item-hover" hover-stay-time="80" bindtap="onNewChat">
          <view class="sidebar-item-icon-wrap sidebar-item-icon-accent">
            <text class="sidebar-item-icon">✦</text>
          </view>
          <text class="sidebar-item-text">新建会话</text>
          <text class="sidebar-item-shortcut">N</text>
        </view>
      </view>

      <view class="sidebar-section">
        <text class="sidebar-section-label">浏览</text>
        <view class="sidebar-item" hover-class="sidebar-item-hover" hover-stay-time="80" bindtap="onGoSessions">
          <view class="sidebar-item-icon-wrap"><text class="sidebar-item-icon">💬</text></view>
          <text class="sidebar-item-text">会话历史</text>
        </view>
        <view class="sidebar-item" hover-class="sidebar-item-hover" hover-stay-time="80" bindtap="onGoTools">
          <view class="sidebar-item-icon-wrap"><text class="sidebar-item-icon">🔧</text></view>
          <text class="sidebar-item-text">工具</text>
        </view>
        <view class="sidebar-item" hover-class="sidebar-item-hover" hover-stay-time="80" bindtap="onGoSkills">
          <view class="sidebar-item-icon-wrap"><text class="sidebar-item-icon">📖</text></view>
          <text class="sidebar-item-text">技能</text>
        </view>
        <view class="sidebar-item" hover-class="sidebar-item-hover" hover-stay-time="80" bindtap="onGoPlugins">
          <view class="sidebar-item-icon-wrap"><text class="sidebar-item-icon">🔌</text></view>
          <text class="sidebar-item-text">插件</text>
        </view>
        <view class="sidebar-item" hover-class="sidebar-item-hover" hover-stay-time="80" bindtap="onGoAgents">
          <view class="sidebar-item-icon-wrap"><text class="sidebar-item-icon">🤖</text></view>
          <text class="sidebar-item-text">Agent</text>
        </view>
      </view>

      <view class="sidebar-section">
        <text class="sidebar-section-label">配置</text>
        <view class="sidebar-item" hover-class="sidebar-item-hover" hover-stay-time="80" bindtap="onGoUsage">
          <view class="sidebar-item-icon-wrap"><text class="sidebar-item-icon">📊</text></view>
          <text class="sidebar-item-text">使用统计</text>
        </view>
        <view class="sidebar-item" hover-class="sidebar-item-hover" hover-stay-time="80" bindtap="onGoSettings">
          <view class="sidebar-item-icon-wrap"><text class="sidebar-item-icon">⚙️</text></view>
          <text class="sidebar-item-text">设置</text>
        </view>
      </view>
    </scroll-view>

    <!-- Footer Status -->
    <view class="sidebar-footer">
      <view class="sidebar-status">
        <view class="sidebar-conn-row" bindtap="onGoSettings">
          <view class="sidebar-conn-dot-wrap">
            <view class="sidebar-conn-dot-pulse {{isConnected ? 'sidebar-conn-dot-pulse-ok' : ''}}"></view>
            <view class="sidebar-conn-dot {{isConnected ? 'sidebar-conn-dot-ok' : ''}}"></view>
          </view>
          <view class="sidebar-conn-info">
            <text class="sidebar-conn-text">{{isConnected ? '已连接' : '未连接'}}</text>
            <text class="sidebar-conn-url">{{serverUrlDisplay}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>