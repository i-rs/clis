<view class="chat-page">
  <!-- Messages -->
  <scroll-view class="messages-scroll" scroll-y scroll-into-view="{{scrollTarget}}" scroll-with-animation>
    <!-- Empty -->
    <view class="empty-state" wx:if="{{messages.length === 0 && !loading}}">
      <view class="empty-logo"><text class="empty-logo-text">AI</text></view>
      <text class="empty-title">开始对话</text>
      <text class="empty-desc">与 AI 助理交流</text>
      <view class="suggestions">
        <view class="suggest-btn" bindtap="onSuggest" data-text="帮我总结今天的数据"><text class="suggest-text">总结今天的数据</text></view>
        <view class="suggest-btn" bindtap="onSuggest" data-text="查看我的待办事项"><text class="suggest-text">查看待办事项</text></view>
        <view class="suggest-btn" bindtap="onSuggest" data-text="今天心情怎么样"><text class="suggest-text">记录心情</text></view>
      </view>
    </view>

    <!-- Messages List -->
    <view class="message-list" wx:if="{{messages.length > 0}}">
      <view wx:for="{{messages}}" wx:key="id" id="msg-{{item.id}}">

        <!-- ===== User Message ===== -->
        <view class="msg-row msg-row-user" wx:if="{{item.role === 'user'}}">
          <view class="avatar avatar-user"><text class="avatar-text">U</text></view>
          <view class="msg-content msg-content-user">
            <view class="msg-bubble msg-bubble-user">
              <text class="msg-text msg-text-user">{{item.content}}</text>
            </view>
          </view>
        </view>

        <!-- ===== AI Thinking (reasoning only, no content) ===== -->
        <view class="msg-row msg-row-ai" wx:if="{{item.role === 'assistant' && item.reasoning && !item.content}}">
          <view class="avatar avatar-ai"><text class="avatar-text">AI</text></view>
          <view class="msg-content msg-content-ai">
            <view class="thinking-card" bindtap="onToggleReasoning" data-id="{{item.id}}">
              <view class="thinking-header">
                <view class="thinking-icon-wrap">
                  <text class="thinking-icon">◈</text>
                </view>
                <text class="thinking-label">Thinking</text>
                <text class="thinking-count">{{item.reasoningCount}}</text>
                <text class="thinking-chevron">{{item.reasoningExpanded ? '▼' : '▶'}}</text>
              </view>
              <view class="thinking-body" wx:if="{{item.reasoningExpanded}}">
                <text class="thinking-text">{{item.reasoning}}</text>
              </view>
            </view>
          </view>
        </view>

        <!-- ===== Tool Call ===== -->
        <view class="msg-row msg-row-ai" wx:if="{{item.role === 'tool_call'}}">
          <view class="avatar avatar-tool"><text class="avatar-text">⚙</text></view>
          <view class="msg-content msg-content-ai">
            <view class="tool-card" bindtap="onToggleTool" data-id="{{item.id}}">
              <view class="tool-header">
                <view class="tool-status {{item.result ? 'tool-status-done' : 'tool-status-running'}}">
                  <view class="tool-status-icon {{item.result ? '' : 'tool-status-spin'}}">{{item.result ? '✓' : '↻'}}</view>
                </view>
                <text class="tool-name">{{item.name}}</text>
                <text class="tool-preview" wx:if="{{!item.expanded && item.result}}">{{item.preview}}</text>
                <text class="tool-chevron">{{item.expanded ? '▼' : '▶'}}</text>
              </view>
              <view class="tool-body" wx:if="{{item.expanded}}">
                <view class="tool-section" wx:if="{{item.args}}">
                  <text class="tool-section-label">Args</text>
                  <view class="tool-code-wrap"><text class="tool-code">{{item.args}}</text></view>
                </view>
                <view class="tool-section" wx:if="{{item.result}}">
                  <text class="tool-section-label">Result</text>
                  <view class="tool-code-wrap"><text class="tool-code">{{item.result}}</text></view>
                </view>
              </view>
            </view>
          </view>
        </view>

        <!-- ===== AI Message (with content) ===== -->
        <view class="msg-row msg-row-ai" wx:if="{{item.role === 'assistant' && item.content}}">
          <view class="avatar avatar-ai"><text class="avatar-text">AI</text></view>
          <view class="msg-content msg-content-ai">
            <view class="reasoning-fold" wx:if="{{item.reasoning}}" bindtap="onToggleReasoning" data-id="{{item.id}}">
              <view class="reasoning-fold-header">
                <text class="reasoning-fold-icon">◈</text>
                <text class="reasoning-fold-label">Reasoning</text>
                <text class="reasoning-fold-count">{{item.reasoningCount}}</text>
                <text class="reasoning-fold-chevron">{{item.reasoningExpanded ? '▼' : '▶'}}</text>
              </view>
              <view class="reasoning-fold-body" wx:if="{{item.reasoningExpanded}}">
                <text class="reasoning-fold-text">{{item.reasoning}}</text>
              </view>
            </view>
            <view class="msg-bubble msg-bubble-ai">
              <text class="msg-text msg-text-ai">{{item.content}}</text>
            </view>
          </view>
        </view>
      </view>

      <!-- Streaming -->
      <view class="msg-row msg-row-ai" wx:if="{{loading || streamingContent || streamingReasoning || renderTick}}">
        <view class="avatar avatar-ai"><text class="avatar-text">AI</text></view>
        <view class="msg-content msg-content-ai">
          <view class="reasoning-fold" wx:if="{{streamingReasoning}}">
            <view class="reasoning-fold-header">
              <text class="reasoning-fold-icon">◈</text>
                <text class="reasoning-fold-label">Thinking...</text>
                <text class="reasoning-fold-chevron">▼</text>
            </view>
            <view class="reasoning-fold-body">
              <text class="reasoning-fold-text">{{streamingReasoning}}</text>
            </view>
          </view>
          <view class="msg-bubble msg-bubble-ai" wx:if="{{streamingContent}}">
            <text class="msg-text msg-text-ai">{{streamingContent}}</text>
          </view>
          <view class="thinking-dots" wx:if="{{loading && !streamingContent && !streamingReasoning}}">
            <view class="dot dot-1"></view>
            <view class="dot dot-2"></view>
            <view class="dot dot-3"></view>
          </view>
        </view>
      </view>

      <view id="msg-bottom" class="msg-bottom-anchor"></view>
    </view>
  </scroll-view>

  <!-- Connection -->
  <view class="conn-bar" wx:if="{{!isConnected}}">
    <text class="conn-dot"></text>
    <text class="conn-text">{{noServer ? '未配置服务器' : '未连接到服务器'}}</text>
    <view class="conn-action" wx:if="{{noServer}}" bindtap="onGoSettings">
      <text>去设置</text>
    </view>
  </view>

  <!-- Input Bar -->
  <view class="input-bar-wrap">
    <view class="input-bar">
      <view class="input-bar-inner">
        <view class="input-menu-btn" bindtap="onToggleMenu">
          <text class="input-menu-icon">☰</text>
        </view>
        <input class="input-text" value="{{inputText}}" placeholder="输入消息..." placeholder-class="ph" bindinput="onInput" bindfocus="onInputFocus" bindblur="onInputBlur" bindconfirm="onSend" confirm-type="send" maxlength="-1" cursor-spacing="20" />
        <view class="input-send {{inputText.length > 0 ? 'input-send-on' : ''}}" bindtap="onSend">
          <text class="input-send-icon">↑</text>
        </view>
      </view>
      <view style="height: env(safe-area-inset-bottom);"></view>
    </view>
  </view>

  <!-- Sidebar -->
  <view class="sidebar-mask {{menuOpen ? 'sidebar-mask-show' : ''}}" bindtap="onCloseMenu"></view>
  <view class="sidebar {{menuOpen ? 'sidebar-open' : ''}}">
    <view class="sidebar-header">
      <view class="sidebar-logo"><text class="sidebar-logo-text">AI</text></view>
      <text class="sidebar-title">i-rs-claw</text>
    </view>
    <view class="sidebar-nav">
      <view class="sidebar-item" bindtap="onNewChat"><text class="sidebar-item-icon">✦</text><text class="sidebar-item-text">新建会话</text></view>
      <view class="sidebar-divider"></view>
      <view class="sidebar-item" bindtap="onGoSessions"><text class="sidebar-item-icon">💬</text><text class="sidebar-item-text">会话历史</text></view>
      <view class="sidebar-item" bindtap="onGoTools"><text class="sidebar-item-icon">🔧</text><text class="sidebar-item-text">工具</text></view>
      <view class="sidebar-item" bindtap="onGoSkills"><text class="sidebar-item-icon">📖</text><text class="sidebar-item-text">技能</text></view>
      <view class="sidebar-item" bindtap="onGoPlugins"><text class="sidebar-item-icon">🔌</text><text class="sidebar-item-text">插件</text></view>
      <view class="sidebar-item" bindtap="onGoAgents"><text class="sidebar-item-icon">🤖</text><text class="sidebar-item-text">Agent</text></view>
      <view class="sidebar-divider"></view>
      <view class="sidebar-item" bindtap="onGoSettings"><text class="sidebar-item-icon">⚙️</text><text class="sidebar-item-text">设置</text></view>
    </view>
    <view class="sidebar-footer">
      <view class="sidebar-conn">
        <view class="sidebar-conn-dot {{isConnected ? 'sidebar-conn-dot-ok' : ''}}"></view>
        <text class="sidebar-conn-text">{{isConnected ? '已连接' : '未连接'}}</text>
      </view>
    </view>
  </view>
</view>