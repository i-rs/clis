page {
  background: var(--bg);
  min-height: 100vh;
}

.servers-page {
  padding: 0 16rpx calc(40rpx + env(safe-area-inset-bottom)) 16rpx;
}

.section {
  margin-top: 32rpx;
}

.section-label {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--text-2);
  text-transform: uppercase;
  letter-spacing: 1.5rpx;
  display: block;
  margin-bottom: 10rpx;
  padding: 0 0 0 16rpx;
}

/* Connection Status */
.card-conn {
  padding: 0 16rpx;
}
.conn-row {
  display: flex;
  align-items: center;
  padding: 24rpx 16rpx;
  gap: 20rpx;
}
.conn-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  flex-shrink: 0;
}
.conn-dot-ok {
  background: #34C759;
  box-shadow: 0 0 12rpx rgba(52, 199, 89, 0.5);
}
.conn-dot-err {
  background: #8E8E93;
}
.conn-info {
  flex: 1;
  min-width: 0;
}
.conn-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
  display: block;
}
.conn-url {
  font-size: 24rpx;
  color: var(--text-2);
  display: block;
  margin-top: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-family: ui-monospace, "SF Mono", Menlo, monospace;
}

/* Card */
.card {
  background: var(--surface);
  border-radius: var(--r-lg);
  padding: 0;
}

/* Server Card */
.srv-item {
  display: flex;
  align-items: center;
  padding: 24rpx 16rpx;
  border-bottom: 1rpx solid var(--border);
}
.srv-item:last-child {
  border-bottom: none;
}
.srv-tap {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex: 1;
  min-width: 0;
  padding: 8rpx 0;
}
.srv-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: var(--r-md);
  background: var(--surface-2);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: background 0.18s;
}
.srv-icon-active {
  background: var(--accent-bg);
}
.srv-icon-text {
  font-size: 32rpx;
  line-height: 1;
}
.srv-body {
  flex: 1;
  min-width: 0;
}
.srv-name-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.srv-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.srv-check {
  font-size: 24rpx;
  color: var(--accent);
  font-weight: 700;
  flex-shrink: 0;
}
.srv-url {
  font-size: 24rpx;
  color: var(--text-2);
  display: block;
  margin-top: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-family: ui-monospace, "SF Mono", Menlo, monospace;
}
.srv-active .srv-tap {
  background: linear-gradient(90deg, var(--accent-bg) 0%, transparent 100%);
  margin: -8rpx -12rpx;
  padding: 8rpx 12rpx;
  border-radius: var(--r-md);
}

/* Server Actions */
.srv-actions {
  display: flex;
  align-items: center;
  gap: 4rpx;
  flex-shrink: 0;
  margin-left: 8rpx;
}
.srv-action-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--r-sm);
  transition: background 0.18s;
}
.srv-action-btn:active {
  background: var(--surface-2);
}
.srv-action-icon {
  font-size: 28rpx;
  line-height: 1;
}

/* Add Button */
.add-btn-wrap {
  margin-top: 16rpx;
}
.add-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 24rpx 0;
  transition: background 0.18s;
}
.add-btn:active {
  background: var(--surface-2);
}
.add-btn-icon {
  font-size: 36rpx;
  font-weight: 300;
  color: var(--accent);
}
.add-btn-text {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--accent);
}

/* Empty Card */
.card-empty {
  padding: 48rpx 24rpx;
  text-align: center;
}
.empty-text {
  font-size: 28rpx;
  color: var(--text-3);
}

/* Edit Sheet */
.sheet-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.25s ease;
}
.sheet-mask-show {
  opacity: 1;
  pointer-events: auto;
}
.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--surface);
  border-radius: 24rpx 24rpx 0 0;
  z-index: 1001;
  transform: translateY(100%);
  transition: transform 0.3s ease;
  max-height: 80vh;
}
.sheet-show {
  transform: translateY(0);
}
.sheet-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 40rpx 24rpx;
  border-bottom: 1rpx solid var(--border);
}
.sheet-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text);
}
.sheet-close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: var(--text-3);
  font-weight: 300;
}
.sheet-body {
  padding: 32rpx 40rpx;
}
.sheet-footer {
  display: flex;
  gap: 24rpx;
  padding: 24rpx 40rpx calc(24rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--border);
}
.sheet-btn {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--r-lg);
  font-size: 30rpx;
  font-weight: 500;
  transition: background 0.18s;
}
.sheet-btn-cancel {
  background: var(--surface-2);
  color: var(--text);
}
.sheet-btn-cancel:active {
  background: var(--surface-3);
}
.sheet-btn-confirm {
  background: var(--accent);
  color: #fff;
}
.sheet-btn-confirm:active {
  opacity: 0.85;
}

/* Form Items */
.form-item {
  margin-bottom: 28rpx;
}
.form-item:last-child {
  margin-bottom: 0;
}
.form-label {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-2);
  display: block;
  margin-bottom: 12rpx;
}
.form-input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  background: var(--surface-2);
  border-radius: var(--r-md);
  font-size: 30rpx;
  color: var(--text);
  box-sizing: border-box;
}
.form-input:focus {
  outline: 2rpx solid var(--accent);
}
.form-item-check {
  margin-top: 20rpx;
}
.form-item-check label {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 26rpx;
  color: var(--text-2);
}
