.usage-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--bg);
  overflow: hidden;
  position: relative;
}
.usage-page::before {
  content: '';
  position: fixed;
  top: 0; left: 0; right: 0;
  height: 50vh;
  pointer-events: none; z-index: 0;
  background:
    radial-gradient(ellipse 70% 50% at 50% 0%, var(--accent-bg-2) 0%, transparent 65%);
}

/* Navbar */
.navbar {
  display: flex;
  align-items: center;
  padding: 12rpx 20rpx;
  padding-top: calc(12rpx + env(safe-area-inset-top));
  background: transparent;
  flex-shrink: 0;
  z-index: 10;
  position: relative;
}
.nav-btn {
  width: 72rpx; height: 72rpx; border-radius: 22rpx;
  display: flex; align-items: center; justify-content: center;
  background: var(--surface);
  border: 1rpx solid var(--border);
  box-shadow: var(--shadow-sm), var(--highlight);
  transition: all 0.2s;
}
.nav-btn:active { transform: scale(0.92); background: var(--surface-2); }
.nav-btn-icon { font-size: 36rpx; color: var(--text); font-weight: 400; }
.nav-center { flex: 1; text-align: center; min-width: 0; }
.nav-title { font-size: 30rpx; font-weight: 700; color: var(--text); letter-spacing: -0.5rpx; }

/* Period Bar */
.period-bar {
  display: flex;
  gap: 12rpx;
  padding: 16rpx 24rpx;
  background: transparent;
  flex-shrink: 0;
  position: relative; z-index: 1;
}
.period-btn {
  flex: 1;
  height: 72rpx;
  border-radius: var(--r-md);
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--surface);
  border: 1rpx solid var(--border);
  transition: all 0.18s;
  box-shadow: var(--highlight);
}
.period-btn-active {
  background: var(--accent-bg);
  border-color: var(--accent);
  box-shadow: 0 4rpx 12rpx var(--accent-glow), var(--highlight);
}
.period-label {
  font-size: 26rpx;
  color: var(--text-2);
  font-weight: 500;
  letter-spacing: 0.3rpx;
}
.period-btn-active .period-label { color: var(--accent); font-weight: 600; }

/* Loading */
.loading-state {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
}
.loading-spinner {
  width: 64rpx;
  height: 64rpx;
  border: 4rpx solid var(--border);
  border-top-color: var(--accent);
  border-radius: 50%;
  animation: spin 1s linear infinite;
}
.loading-text { font-size: 28rpx; color: var(--text-2); }

/* Error */
.error-state {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
}
.error-text { font-size: 28rpx; color: var(--red); }
.retry-btn {
  padding: 16rpx 48rpx;
  background: var(--accent-bg);
  border: 1rpx solid var(--accent);
  border-radius: var(--r-full);
  transition: all 0.18s;
}
.retry-btn:active { transform: scale(0.96); }
.retry-text { font-size: 28rpx; color: var(--accent); font-weight: 600; }

/* Stats Scroll */
.stats-scroll {
  flex: 1;
  overflow: hidden;
  padding: 16rpx 24rpx 24rpx;
  position: relative;
  z-index: 1;
}

/* Main Card */
.stats-card {
  background: var(--surface);
  border: 1rpx solid var(--border);
  border-radius: var(--r-lg);
  padding: var(--s-4);
  margin-bottom: var(--s-3);
  box-shadow: var(--shadow-sm), var(--highlight);
}
.main-card {
  background: linear-gradient(135deg, var(--accent-bg) 0%, var(--accent-bg-2) 100%);
  border-color: var(--accent);
  box-shadow: 0 8rpx 24rpx var(--accent-glow), var(--highlight);
  position: relative;
  overflow: hidden;
}
.main-card::before {
  content: '';
  position: absolute; top: 0; left: 0; right: 0;
  height: 50%;
  background: radial-gradient(ellipse 80% 100% at 50% 0%, rgba(255, 255, 255, 0.06) 0%, transparent 70%);
  pointer-events: none;
}

.stat-total {
  text-align: center;
  margin-bottom: 32rpx;
  position: relative;
}
.stat-total-label {
  font-size: 26rpx;
  color: var(--text-2);
  display: block;
  margin-bottom: 8rpx;
  letter-spacing: 0.3rpx;
}
.stat-total-value {
  font-size: 64rpx;
  font-weight: 700;
  color: var(--text);
  font-family: ui-monospace, "SF Mono", Menlo, monospace;
  letter-spacing: -2rpx;
  background: linear-gradient(135deg, var(--text) 0%, var(--accent) 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.stat-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 48rpx;
}
.stat-divider {
  width: 1rpx;
  height: 64rpx;
  background: var(--border);
}
.stat-item { text-align: center; }
.stat-item-value {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text);
  font-family: ui-monospace, "SF Mono", Menlo, monospace;
  display: block;
  letter-spacing: -0.5rpx;
}
.stat-item-label {
  font-size: 24rpx;
  color: var(--text-3);
  display: block;
  margin-top: 4rpx;
}

/* Section Title */
.section-title {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-2);
  margin-bottom: 16rpx;
  margin-left: 8rpx;
  letter-spacing: 0.3rpx;
  text-transform: uppercase;
}

/* Today Stats */
.today-stats { display: flex; gap: 16rpx; }
.today-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 28rpx 16rpx;
  background: var(--surface);
  border-radius: var(--r-md);
  border: 1rpx solid var(--border);
  box-shadow: var(--shadow-sm), var(--highlight);
  transition: transform 0.18s;
}
.today-item:active { transform: scale(0.97); }
.today-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: var(--r-md);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  box-shadow: var(--highlight);
}
.today-icon-req { background: var(--accent-bg); }
.today-icon-tokens { background: var(--blue-bg); }
.today-icon-cost { background: var(--green-bg); }
.today-info { text-align: center; }
.today-value {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text);
  font-family: ui-monospace, "SF Mono", Menlo, monospace;
  display: block;
  letter-spacing: -0.5rpx;
}
.today-label {
  font-size: 22rpx;
  color: var(--text-3);
  display: block;
  margin-top: 2rpx;
}

/* Tips */
.tips-card {
  background: var(--surface);
  border: 1rpx solid var(--border);
  border-radius: var(--r-lg);
  padding: var(--s-3);
  box-shadow: var(--shadow-sm), var(--highlight);
}
.tips-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
  display: block;
  margin-bottom: 12rpx;
  letter-spacing: -0.2rpx;
}
.tips-text {
  font-size: 24rpx;
  color: var(--text-2);
  line-height: 1.65;
  display: block;
}

/* Empty */
.empty-state {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}
.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
  opacity: 0.5;
  filter: grayscale(0.5);
}
.empty-text {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 12rpx;
  letter-spacing: -0.3rpx;
}
