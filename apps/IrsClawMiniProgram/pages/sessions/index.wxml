<view class="page">
  <view class="navbar">
    <view class="nav-btn" bindtap="goBack">
      <text>←</text>
    </view>
    <view class="nav-center">
      <text class="nav-title">会话历史</text>
    </view>
    <view class="nav-right"></view>
  </view>

  <view wx:if="{{sessions.length > 0}}">
    <view class="card" style="margin-top: 24rpx;">
      <view class="item" wx:for="{{sessions}}" wx:key="id" bindtap="onSwitch" data-id="{{item.id}}" data-title="{{item.title}}">
        <view class="item-icon purple">
          <text>💬</text>
        </view>
        <view class="item-body">
          <text class="item-title">{{item.title || '未命名会话'}}</text>
          <text class="item-desc">{{item.message_count || 0}} 条消息 · {{item.updated_at || ''}}</text>
        </view>
        <text class="item-arrow">›</text>
      </view>
    </view>
  </view>

  <view class="empty" wx:if="{{loaded && sessions.length === 0}}">
    <view class="empty-icon">💬</view>
    <text class="empty-title">暂无会话</text>
    <text class="empty-desc">开始新对话后，会话将显示在这里</text>
  </view>
</view>
