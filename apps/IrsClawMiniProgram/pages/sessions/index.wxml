<view class="page">
  <view class="navbar">
    <view class="nav-btn" bindtap="goBack">
      <text>←</text>
    </view>
    <view class="nav-center">
      <text class="nav-title">Sessions</text>
    </view>
    <view class="nav-right"></view>
  </view>

  <view wx:if="{{loaded && groups.length > 0}}" class="sessions-content">
    <view wx:for="{{groups}}" wx:key="name" class="sec-group">
      <text class="sec-label">{{item.name}}</text>
      <view class="sec-card">
        <view wx:for="{{item.items}}" wx:key="id" wx:for-item="sess" class="sess-row">
          <view class="sess-info" bindtap="onSwitch" data-id="{{sess.id}}">
            <view class="sess-icon">
              <text class="sess-icon-text">💬</text>
            </view>
            <view class="sess-body">
              <text class="sess-title">{{sess.title}}</text>
              <view class="sess-meta">
                <text class="sess-count">{{sess.messageCount}} msgs</text>
                <text class="sess-meta-sep" wx:if="{{sess.agentId && sess.agentId !== 'default'}}">·</text>
                <text class="sess-agent" wx:if="{{sess.agentId && sess.agentId !== 'default'}}">{{sess.agentId}}</text>
              </view>
            </view>
            <text class="sess-date">{{sess.shortDate}}</text>
            <text class="sess-arrow">›</text>
          </view>
          <view class="sess-del" bindtap="deleteSession" data-id="{{sess.id}}">
            <text class="sess-del-text">×</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="empty" wx:if="{{loaded && groups.length === 0}}">
    <view class="empty-icon">💬</view>
    <text class="empty-title">No Sessions</text>
    <text class="empty-desc">Start a new conversation to begin.</text>
  </view>
</view>
