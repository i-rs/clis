page {
  background: var(--bg);
  min-height: 100vh;
}

.agent-current { flex-shrink: 0; }

.current-tag {
  font-size: 20rpx;
  color: var(--green);
  padding: 4rpx 12rpx;
  border: 1rpx solid var(--green);
  border-radius: var(--r-full);
  font-weight: 600;
  letter-spacing: 0.5rpx;
  background: var(--green-bg);
}

.tip {
  text-align: center;
  padding: 32rpx 24rpx;
  color: var(--text-3);
  font-size: 24rpx;
  letter-spacing: 0.3rpx;
}

/* Modal */
.modal {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.modal-mask {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.55);
  animation: fadeIn 0.22s ease;
}
@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }

.modal-content {
  position: relative;
  width: 100%;
  max-height: 85vh;
  background: var(--surface);
  border-radius: var(--r-lg) var(--r-lg) 0 0;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  box-shadow: var(--shadow-lg);
  animation: slideUp 0.32s cubic-bezier(0.16, 1, 0.3, 1);
}
@keyframes slideUp {
  from { transform: translateY(40rpx); opacity: 0; }
  to { transform: translateY(0); opacity: 1; }
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--s-4);
  border-bottom: 1rpx solid var(--border);
}

.modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text);
  letter-spacing: -0.5rpx;
}

.modal-close {
  font-size: 48rpx;
  color: var(--text-3);
  line-height: 1;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  transition: background 0.18s;
  font-weight: 300;
}
.modal-close:active { background: var(--surface-2); }

.modal-body {
  flex: 1;
  overflow-y: auto;
  padding: var(--s-3) var(--s-4);
}

.form-item { margin-bottom: var(--s-3); }

.form-label {
  display: block;
  font-size: 24rpx;
  color: var(--text-2);
  margin-bottom: 12rpx;
  font-weight: 500;
}

.form-input,
.form-textarea {
  width: 100%;
  padding: 20rpx 24rpx;
  background: var(--bg);
  border: 1rpx solid var(--border);
  border-radius: var(--r-sm);
  font-size: 28rpx;
  color: var(--text);
  box-sizing: border-box;
  transition: border-color 0.18s, box-shadow 0.18s;
  font-family: inherit;
}
.form-input { height: 80rpx; padding: 0 24rpx; }
.form-textarea { min-height: 160rpx; padding: 20rpx 24rpx; line-height: 1.6; }
.form-input:focus,
.form-textarea:focus {
  border-color: var(--border-focus);
  box-shadow: 0 0 0 2rpx var(--accent-bg);
  outline: none;
}
.form-input::placeholder,
.form-textarea::placeholder { color: var(--text-3); }

.modal-footer {
  display: flex;
  gap: var(--s-3);
  padding: var(--s-3) var(--s-4);
  border-top: 1rpx solid var(--border);
  background: var(--surface);
  padding-bottom: calc(var(--s-3) + env(safe-area-inset-bottom));
}

.btn {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--r-md);
  font-size: 30rpx;
  font-weight: 600;
  transition: all 0.18s;
  letter-spacing: 0.3rpx;
}
.btn-cancel {
  background: var(--surface-2);
  color: var(--text);
  border: 1rpx solid var(--border);
}
.btn-cancel:active { background: var(--surface-3); }
.btn-primary {
  background: linear-gradient(135deg, var(--accent) 0%, var(--accent-2) 100%);
  color: var(--text-on-accent);
  box-shadow: var(--shadow-glow);
}
.btn-primary:active { transform: scale(0.98); opacity: 0.92; }

.modal-delete {
  padding: 24rpx;
  text-align: center;
}
.modal-delete text {
  font-size: 28rpx;
  color: var(--red);
  font-weight: 500;
}
