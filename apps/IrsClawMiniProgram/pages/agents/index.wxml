<view class="page">
  <view class="navbar">
    <view class="nav-btn" bindtap="goBack">
      <text>←</text>
    </view>
    <view class="nav-center">
      <text class="nav-title">Agent</text>
    </view>
    <view class="nav-right">
      <view class="nav-btn" bindtap="onAddAgent">
        <text>+</text>
      </view>
    </view>
  </view>

  <view wx:if="{{agents.length > 0}}">
    <view class="card" style="margin-top: 24rpx;">
      <view class="item" wx:for="{{agents}}" wx:key="id" catchtap="onSwitchAgent" data-id="{{item.id}}" longpress="onShowAgentDetail">
        <view class="item-icon purple">
          <text>👤</text>
        </view>
        <view class="item-body">
          <text class="item-title">{{item.id}}</text>
          <text class="item-desc">{{item.model || ''}}</text>
        </view>
        <view class="agent-current" wx:if="{{item.id === currentAgent}}">
          <text class="current-tag">当前</text>
        </view>
      </view>
    </view>
  </view>

  <view class="tip" wx:if="{{loaded && agents.length > 0}}">
    <text>长按查看详情</text>
  </view>

  <view class="empty" wx:if="{{loaded && agents.length === 0}}">
    <view class="empty-icon">👤</view>
    <text class="empty-title">暂无 Agent</text>
    <text class="empty-desc">点击右上角 + 添加 Agent</text>
  </view>
</view>

<view class="modal" wx:if="{{showingForm}}">
  <view class="modal-mask" bindtap="onCloseForm"></view>
  <view class="modal-content">
    <view class="modal-header">
      <text class="modal-title">{{formMode === 'create' ? '创建 Agent' : '编辑 Agent'}}</text>
      <view class="modal-close" bindtap="onCloseForm">×</view>
    </view>
    <view class="modal-body">
      <view class="form-item">
        <text class="form-label">Agent ID</text>
        <input class="form-input" value="{{formData.id}}" data-field="id" bindinput="onFormInput" placeholder="唯一标识符" disabled="{{formMode === 'edit'}}" />
      </view>
      <view class="form-item">
        <text class="form-label">Provider</text>
        <input class="form-input" value="{{formData.provider}}" data-field="provider" bindinput="onFormInput" placeholder="如: openai" />
      </view>
      <view class="form-item">
        <text class="form-label">Model</text>
        <input class="form-input" value="{{formData.model}}" data-field="model" bindinput="onFormInput" placeholder="如: gpt-4o-mini" />
      </view>
      <view class="form-item">
        <text class="form-label">API Key</text>
        <input class="form-input" value="{{formData.api_key}}" data-field="api_key" bindinput="onFormInput" placeholder="可选" type="text" password="true" />
      </view>
      <view class="form-item">
        <text class="form-label">Base URL</text>
        <input class="form-input" value="{{formData.base_url}}" data-field="base_url" bindinput="onFormInput" placeholder="可选" />
      </view>
      <view class="form-item">
        <text class="form-label">System Prompt</text>
        <textarea class="form-textarea" value="{{formData.system_prompt}}" data-field="system_prompt" bindinput="onFormInput" placeholder="可选" />
      </view>
    </view>
    <view class="modal-footer">
      <view class="btn btn-cancel" bindtap="onCloseForm">取消</view>
      <view class="btn btn-primary" bindtap="onSubmitForm">保存</view>
    </view>
    <view class="modal-delete" wx:if="{{formMode === 'edit' && editingAgent.id !== 'default'}}" bindtap="onDeleteAgent">
      <text>删除此 Agent</text>
    </view>
  </view>
</view>