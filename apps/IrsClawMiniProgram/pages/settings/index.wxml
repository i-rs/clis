<view class="settings-page">
  <view class="navbar">
    <view class="nav-btn" bindtap="goBack"><text>←</text></view>
    <view class="nav-center"><text class="nav-title">设置</text></view>
    <view class="nav-right"></view>
  </view>

  <!-- Connection Status -->
  <view class="section">
    <text class="section-label">连接状态</text>
    <view class="card">
      <view class="status">
        <view class="status-dot {{isConnected ? 'ok' : ''}}"></view>
        <text class="status-text">{{isConnected ? '已连接' : '未连接'}}</text>
        <text class="status-extra">{{displayUrl}}</text>
      </view>
    </view>
  </view>

  <!-- Appearance -->
  <view class="section">
    <text class="section-label">外观</text>
    <view class="card">
      <view class="field-row">
        <text class="field-label">深色模式</text>
        <view class="toggle {{theme === 'dark' ? 'on' : ''}}" bindtap="toggleTheme"></view>
      </view>
    </view>
  </view>

  <!-- Servers -->
  <view class="section">
    <text class="section-label">服务器</text>

    <view class="card" wx:if="{{servers.length > 0}}">
      <view wx:for="{{servers}}" wx:key="id" class="srv-row {{item.id === currentServerId ? 'srv-active' : ''}}">
        <view class="srv-info" bindtap="selectServer" data-id="{{item.id}}">
          <view class="srv-icon {{item.id === currentServerId ? 'srv-icon-active' : ''}}">
            <text class="srv-icon-text">🌐</text>
          </view>
          <view class="srv-body">
            <view class="srv-name-row">
              <text class="srv-name">{{item.name}}</text>
              <text class="srv-check" wx:if="{{item.id === currentServerId}}">✓</text>
            </view>
            <text class="srv-url">{{item.url}}</text>
            <text class="srv-token">{{item.tokenDisplay}}</text>
          </view>
          <view class="srv-del" bindtap="deleteServer" data-id="{{item.id}}" data-name="{{item.name}}">
            <text class="srv-del-text">×</text>
          </view>
        </view>
      </view>
    </view>

    <view class="card" wx:else>
      <view class="srv-empty">
        <text class="srv-empty-text">暂无保存的服务器</text>
      </view>
    </view>

    <!-- Add Server -->
    <view class="add-btn-wrap">
      <view class="btn btn-ghost" bindtap="toggleAddForm">{{showAddForm ? '取消' : '+ 添加服务器'}}</view>
    </view>
    <view class="card add-form" wx:if="{{showAddForm}}">
      <view class="field-row">
        <text class="field-label">名称</text>
        <input class="config-input" value="{{newName}}" bindinput="onNewName" placeholder="服务器名称" />
      </view>
      <view class="field-row">
        <text class="field-label">地址</text>
        <input class="config-input" value="{{newUrl}}" bindinput="onNewUrl" placeholder="http://localhost:3000" />
      </view>
      <view class="field-row">
        <text class="field-label">令牌</text>
        <input class="config-input" value="{{newToken}}" bindinput="onNewToken" placeholder="可选" />
      </view>
      <view class="add-form-btn">
        <view class="btn btn-fill" bindtap="addServer">保存并连接</view>
      </view>
    </view>

    <!-- Manual Connect -->
    <view class="add-btn-wrap">
      <view class="btn btn-ghost" bindtap="toggleManual">{{showManual ? '取消' : '手动连接 >>'}}</view>
    </view>
    <view class="card add-form" wx:if="{{showManual}}">
      <view class="field-row">
        <text class="field-label">地址</text>
        <input class="config-input" value="{{manualUrl}}" bindinput="onManualUrl" placeholder="http://localhost:3000" />
      </view>
      <view class="field-row">
        <text class="field-label">令牌</text>
        <input class="config-input" value="{{manualToken}}" bindinput="onManualToken" placeholder="可选" />
      </view>
      <view class="add-form-btn">
        <view class="btn btn-fill" bindtap="manualConnect">连接</view>
      </view>
    </view>
  </view>

  <!-- AI Config -->
  <view class="section" wx:if="{{aiConfig}}">
    <text class="section-label">AI 配置</text>
    <view class="card">
      <view class="info-row"><text>Provider</text><text class="info-val">{{aiConfig.provider || '-'}}</text></view>
      <view class="info-row"><text>Model</text><text class="info-val">{{aiConfig.model || '-'}}</text></view>
    </view>
  </view>
</view>
