<view class="settings-page">
  <view class="navbar">
    <view class="nav-btn" bindtap="goBack"><text>←</text></view>
    <view class="nav-center"><text class="nav-title">设置</text></view>
    <view class="nav-right"></view>
  </view>

  <!-- Appearance -->
  <view class="section">
    <text class="section-label">APPEARANCE</text>
    <view class="card card-themed">
      <view class="theme-row">
        <view class="theme-option {{theme === 'light' ? 'theme-active' : ''}}" data-theme="light" bindtap="setTheme">
          <view class="theme-icon-wrap">
            <text class="theme-icon">☀</text>
          </view>
          <text class="theme-name">Light</text>
        </view>
        <view class="theme-option {{theme === 'system' ? 'theme-active' : ''}}" data-theme="system" bindtap="setTheme">
          <view class="theme-icon-wrap">
            <text class="theme-icon">💻</text>
          </view>
          <text class="theme-name">Auto</text>
        </view>
        <view class="theme-option {{theme === 'dark' ? 'theme-active' : ''}}" data-theme="dark" bindtap="setTheme">
          <view class="theme-icon-wrap">
            <text class="theme-icon">🌙</text>
          </view>
          <text class="theme-name">Dark</text>
        </view>
      </view>
    </view>
  </view>

  <!-- Connection Status -->
  <view class="section">
    <text class="section-label">STATUS</text>
    <view class="card card-conn">
      <view class="conn-row">
        <view class="conn-dot {{isConnected ? 'conn-dot-ok' : 'conn-dot-err'}}"></view>
        <view class="conn-info">
          <text class="conn-title">{{isConnected ? '已连接' : '未连接'}}</text>
          <text class="conn-url">{{displayUrl || '未设置'}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- Backend -->
  <view class="section">
    <text class="section-label">BACKEND</text>
    <view class="card">
      <view class="link-row" bindtap="goToBackend">
        <view class="link-left">
          <view class="link-icon-bg link-icon-bg-backend">
            <text class="link-icon">🖥</text>
          </view>
          <view class="link-info">
            <text class="link-title">服务器</text>
            <text class="link-sub">{{currentServerName || '未设置'}}</text>
          </view>
        </view>
        <text class="link-arrow">›</text>
      </view>
    </view>
  </view>

  <!-- AI Provider -->
  <view class="section">
    <text class="section-label">AI PROVIDER</text>
    <view class="card">
      <view class="link-row" bindtap="goToProvider">
        <view class="link-left">
          <view class="link-icon-bg link-icon-bg-ai">
            <text class="link-icon">🧠</text>
          </view>
          <view class="link-info">
            <text class="link-title">{{aiConfig.provider || 'Provider'}}</text>
            <text class="link-sub">{{aiConfig.model || '未设置'}}</text>
          </view>
        </view>
        <text class="link-arrow">›</text>
      </view>
    </view>
  </view>

  <!-- Agents -->
  <view class="section">
    <text class="section-label">AGENTS</text>
    <view class="card">
      <view class="link-row" bindtap="goToAgents">
        <view class="link-left">
          <view class="link-icon-bg link-icon-bg-agents">
            <text class="link-icon">👥</text>
          </view>
          <view class="link-info">
            <text class="link-title">管理 Agents</text>
          </view>
        </view>
        <text class="link-arrow">›</text>
      </view>
    </view>
  </view>

  <!-- About -->
  <view class="section">
    <text class="section-label">ABOUT</text>
    <view class="card">
      <view class="link-row">
        <view class="link-left">
          <view class="link-icon-bg link-icon-bg-about">
            <text class="link-icon">ⓘ</text>
          </view>
          <view class="link-info">
            <text class="link-title">Version</text>
          </view>
        </view>
        <text class="link-arrow-text">1.0.0</text>
      </view>
    </view>
  </view>

  <!-- Edit Sheet -->
  <view class="sheet-mask {{showEditSheet ? 'sheet-mask-show' : ''}}" bindtap="hideEditSheet">
    <view class="sheet {{showEditSheet ? 'sheet-show' : ''}}" catchtap="preventMaskTap">
      <view class="sheet-header">
        <text class="sheet-title">{{editingServer ? '编辑服务器' : '添加服务器'}}</text>
        <view class="sheet-close" bindtap="hideEditSheet"><text>×</text></view>
      </view>
      <view class="sheet-body">
        <view class="form-item">
          <text class="form-label">名称</text>
          <input class="form-input" value="{{editName}}" bindinput="onEditName" placeholder="服务器名称" />
        </view>
        <view class="form-item">
          <text class="form-label">地址</text>
          <input class="form-input" value="{{editUrl}}" bindinput="onEditUrl" placeholder="http://localhost:3000" />
        </view>
        <view class="form-item">
          <text class="form-label">令牌</text>
          <input class="form-input" value="{{editToken}}" bindinput="onEditToken" placeholder="可选" password="{{!showToken}}" />
        </view>
        <view class="form-item form-item-check">
          <checkbox-group bindchange="onShowTokenChange">
            <label><checkbox value="show" checked="{{showToken}}" />显示令牌</label>
          </checkbox-group>
        </view>
      </view>
      <view class="sheet-footer">
        <view class="sheet-btn sheet-btn-cancel" bindtap="hideEditSheet"><text>取消</text></view>
        <view class="sheet-btn sheet-btn-confirm" bindtap="saveEdit"><text>保存</text></view>
      </view>
    </view>
  </view>
</view>
