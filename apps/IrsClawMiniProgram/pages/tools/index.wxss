page { background: var(--bg); min-height: 100vh; }

.tools-content {
  padding: 20rpx 24rpx 40rpx;
  position: relative;
  z-index: 1;
}

/* Category Section */
.cat-section { margin-bottom: var(--s-4); }
.cat-header {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 0 4rpx 16rpx;
}
.cat-icon {
  font-size: 26rpx;
  width: 32rpx;
  text-align: center;
  line-height: 1;
}
.cat-name {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--text-3);
  text-transform: uppercase;
  letter-spacing: 1.5rpx;
}
.cat-count {
  font-size: 20rpx;
  color: var(--text-3);
  margin-left: auto;
  font-family: ui-monospace, "SF Mono", Menlo, monospace;
}

/* Tool Grid */
.tool-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

/* Tool Card */
.tool-card {
  width: calc(50% - 8rpx);
  background: var(--surface);
  border-radius: var(--r-lg);
  padding: 28rpx 24rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  border: 1rpx solid var(--border);
  box-shadow: var(--shadow-sm), var(--highlight);
  transition: transform 0.18s, box-shadow 0.18s, border-color 0.18s;
}
.tool-card:active {
  transform: scale(0.96);
  border-color: var(--border-focus);
  box-shadow: var(--shadow-md), var(--highlight);
}

.tool-icon-wrap {
  width: 64rpx;
  height: 64rpx;
  border-radius: var(--r-md);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: var(--highlight);
}
.tool-icon { font-size: 30rpx; line-height: 1; }

.tool-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  letter-spacing: -0.2rpx;
}

.tool-desc {
  font-size: 22rpx;
  color: var(--text-2);
  line-height: 1.55;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
}
