page { background: var(--bg); }

.tools-content {
  padding: 20rpx 24rpx 40rpx;
}

/* Category Section */
.cat-section {
  margin-bottom: 32rpx;
}
.cat-header {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 0 4rpx 16rpx;
}
.cat-icon {
  font-size: 26rpx;
  width: 32rpx;
  text-align: center;
}
.cat-name {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-2);
  text-transform: uppercase;
  letter-spacing: 1rpx;
}
.cat-count {
  font-size: 20rpx;
  color: var(--text-3);
  margin-left: auto;
}

/* Tool Grid */
.tool-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

/* Tool Card */
.tool-card {
  width: calc(50% - 8rpx);
  background: var(--surface);
  border-radius: 24rpx;
  padding: 24rpx 20rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.15);
  transition: transform 0.15s;
}
.tool-card:active {
  transform: scale(0.96);
}

.tool-icon-wrap {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.tool-icon {
  font-size: 28rpx;
}

.tool-name {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text);
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.tool-desc {
  font-size: 22rpx;
  color: var(--text-2);
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
}
