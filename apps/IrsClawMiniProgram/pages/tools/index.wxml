<view class="page">
  <view class="navbar">
    <view class="nav-btn" bindtap="goBack">
      <text>←</text>
    </view>
    <view class="nav-center">
      <text class="nav-title">工具</text>
    </view>
    <view class="nav-right"></view>
  </view>

  <view wx:if="{{loaded && groups.length > 0}}" class="tools-content">
    <view wx:for="{{groups}}" wx:key="name" class="cat-section">
      <view class="cat-header">
        <text class="cat-icon" style="color: {{catColors[item.name]}};">{{catIcons[item.name]}}</text>
        <text class="cat-name">{{item.name}}</text>
        <text class="cat-count">{{item.count}}</text>
      </view>
      <view class="tool-grid">
        <view wx:for="{{item.items}}" wx:key="id" wx:for-item="tool" class="tool-card">
          <view class="tool-icon-wrap" style="background: {{item.bgColor}};">
            <text class="tool-icon" style="color: {{item.color}};">{{catIcons[item.name]}}</text>
          </view>
          <text class="tool-name">{{tool.name}}</text>
          <text class="tool-desc">{{tool.description}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="empty" wx:if="{{loaded && tools.length === 0}}">
    <view class="empty-icon">⚙</view>
    <text class="empty-title">暂无工具</text>
    <text class="empty-desc">连接服务器后，可用工具将显示在这里</text>
  </view>
</view>
