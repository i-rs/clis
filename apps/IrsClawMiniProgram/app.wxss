page {
  --bg: #0A0A0F;
  --surface: #141419;
  --surface-2: #1A1A22;
  --surface-3: #222230;
  --border: rgba(255,255,255,0.06);
  --border-focus: rgba(255,255,255,0.15);
  --text: #EDEDEF;
  --text-2: #8B8B94;
  --text-3: #55555E;
  --accent: #6C5CE7;
  --accent-2: #A29BFE;
  --accent-bg: rgba(108,92,231,0.1);
  --green: #00D68F;
  --green-bg: rgba(0,214,143,0.1);
  --orange: #FFB347;
  --orange-bg: rgba(255,179,71,0.1);
  --red: #FF6B6B;
  --red-bg: rgba(255,107,107,0.1);
  --blue: #74B9FF;
  --blue-bg: rgba(116,185,255,0.1);
  --user-bg: #6C5CE7;
  --user-text: #FFFFFF;
  --ai-bg: #1A1A22;
  --ai-text: #EDEDEF;
  --radius: 14rpx;
  --radius-lg: 20rpx;
  --shadow: 0 2rpx 16rpx rgba(0,0,0,0.3);

  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', sans-serif;
  font-size: 30rpx;
  line-height: 1.6;
  color: var(--text);
  background: var(--bg);
  -webkit-font-smoothing: antialiased;
}

.light {
  --bg: #F5F6FA;
  --surface: #FFFFFF;
  --surface-2: #EEF0F5;
  --surface-3: #DDE0E8;
  --border: rgba(0,0,0,0.06);
  --border-focus: rgba(0,0,0,0.12);
  --text: #1A1A2E;
  --text-2: #6B6B80;
  --text-3: #A0A0B0;
  --accent: #6C5CE7;
  --accent-2: #5A4BD1;
  --accent-bg: rgba(108,92,231,0.08);
  --user-bg: #6C5CE7;
  --user-text: #FFFFFF;
  --ai-bg: #FFFFFF;
  --ai-text: #1A1A2E;
  --shadow: 0 2rpx 16rpx rgba(0,0,0,0.06);
}

.page { min-height: 100vh; background: var(--bg); }

/* Navbar */
.navbar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  padding-top: calc(16rpx + env(safe-area-inset-top));
  background: var(--surface);
  border-bottom: 1rpx solid var(--border);
}
.nav-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: var(--text);
  background: var(--surface-2);
}
.nav-btn:active { background: var(--surface-3); }
.nav-center { flex: 1; text-align: center; }
.nav-title { font-size: 34rpx; font-weight: 700; color: var(--text); letter-spacing: -0.5rpx; }
.nav-sub { font-size: 22rpx; color: var(--text-3); }
.nav-right { width: 72rpx; height: 72rpx; }

/* Card */
.card {
  background: var(--surface);
  border-radius: var(--radius-lg);
  margin: 0 24rpx;
  border: 1rpx solid var(--border);
  overflow: hidden;
}

/* List item */
.item {
  display: flex;
  align-items: center;
  padding: 28rpx 28rpx;
  gap: 24rpx;
}
.item:active { background: var(--surface-2); }
.item + .item { border-top: 1rpx solid var(--border); }
.item-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  flex-shrink: 0;
}
.item-icon.purple { background: var(--accent-bg); }
.item-icon.green { background: var(--green-bg); }
.item-icon.orange { background: var(--orange-bg); }
.item-icon.blue { background: var(--blue-bg); }
.item-icon.red { background: var(--red-bg); }
.item-body { flex: 1; overflow: hidden; }
.item-title { font-size: 30rpx; font-weight: 600; color: var(--text); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.item-desc { font-size: 24rpx; color: var(--text-2); margin-top: 4rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.item-arrow { color: var(--text-3); font-size: 28rpx; }

/* Section */
.section { margin-top: 32rpx; }
.section-label { font-size: 24rpx; font-weight: 600; color: var(--text-3); padding: 0 28rpx 12rpx; letter-spacing: 1rpx; }

/* Field */
.field-row {
  display: flex;
  align-items: center;
  padding: 28rpx 28rpx;
  gap: 20rpx;
}
.field-row + .field-row { border-top: 1rpx solid var(--border); }
.field-label { font-size: 30rpx; color: var(--text); width: 144rpx; flex-shrink: 0; }
.field-input { flex: 1; font-size: 30rpx; color: var(--text); text-align: right; border: none; outline: none; background: transparent; }
.field-input::placeholder { color: var(--text-3); }

/* Info */
.info-row { display: flex; justify-content: space-between; padding: 28rpx; font-size: 30rpx; color: var(--text); }
.info-row + .info-row { border-top: 1rpx solid var(--border); }
.info-val { color: var(--text-2); }

/* Status */
.status { display: flex; align-items: center; padding: 28rpx; gap: 16rpx; }
.status-dot { width: 16rpx; height: 16rpx; border-radius: 50%; background: var(--red); flex-shrink: 0; }
.status-dot.ok { background: var(--green); }
.status-text { font-size: 30rpx; color: var(--text); flex: 1; font-weight: 500; }
.status-extra { font-size: 24rpx; color: var(--text-3); max-width: 300rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

/* Toggle */
.toggle { width: 88rpx; height: 52rpx; border-radius: 26rpx; background: var(--surface-3); position: relative; transition: background 0.25s; }
.toggle.on { background: var(--accent); }
.toggle::after { content: ''; position: absolute; top: 4rpx; left: 4rpx; width: 44rpx; height: 44rpx; border-radius: 50%; background: #fff; box-shadow: 0 2rpx 6rpx rgba(0,0,0,0.15); transition: transform 0.25s cubic-bezier(0.34,1.56,0.64,1); }
.toggle.on::after { transform: translateX(36rpx); }

/* Buttons */
.btn { border-radius: var(--radius); padding: 28rpx; text-align: center; font-size: 30rpx; font-weight: 600; transition: all 0.12s; }
.btn-fill { background: var(--accent); color: #fff; }
.btn-fill:active { opacity: 0.85; }
.btn-ghost { background: transparent; color: var(--accent); border: 1rpx solid var(--border); }
.btn-ghost:active { background: var(--accent-bg); }

/* Empty */
.empty { display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 120rpx 60rpx; text-align: center; }
.empty-icon { width: 100rpx; height: 100rpx; border-radius: 28rpx; background: var(--surface-2); display: flex; align-items: center; justify-content: center; font-size: 44rpx; margin-bottom: 28rpx; }
.empty-title { font-size: 32rpx; font-weight: 600; color: var(--text); margin-bottom: 8rpx; }
.empty-desc { font-size: 26rpx; color: var(--text-2); line-height: 1.5; }