/* ============================================================
 * Design System · 2026
 * - 8-point spacing scale
 * - 3-tier radius (12/18/24)
 * - 3-tier shadow (light/medium/heavy) w/ subtle violet tint
 * - 4-tier type scale (display/title/body/caption)
 * - 4-tier surface elevation (bg/1/2/3)
 * ============================================================ */

page {
  /* ── Spacing scale (8-base) ── */
  --s-1: 8rpx;
  --s-2: 16rpx;
  --s-3: 24rpx;
  --s-4: 32rpx;
  --s-5: 48rpx;
  --s-6: 64rpx;

  /* ── Radius (3 tiers · 统一和谐) ── */
  --r-xs: 8rpx;
  --r-sm: 14rpx;
  --r-md: 22rpx;
  --r-lg: 28rpx;
  --r-full: 999rpx;

  /* ── Dark theme · 微紫调深色 ── */
  --bg: #0A0A12;
  --bg-2: #0F0F18;
  --surface: #15151F;
  --surface-2: #1C1C28;
  --surface-3: #252532;
  --surface-4: #2E2E3D;

  --border: rgba(255, 255, 255, 0.06);
  --border-strong: rgba(255, 255, 255, 0.10);
  --border-focus: rgba(139, 124, 247, 0.55);

  --text: #F0F0F5;
  --text-2: #9494A8;
  --text-3: #5C5C70;
  --text-on-accent: #FFFFFF;

  /* Accent · 柔和紫 */
  --accent: #8B7CF7;
  --accent-2: #A29BFE;
  --accent-3: #6C5CE7;
  --accent-glow: rgba(139, 124, 247, 0.32);
  --accent-bg: rgba(139, 124, 247, 0.12);
  --accent-bg-2: rgba(139, 124, 247, 0.06);

  /* Semantic · 4 colors, each with bg/dark */
  --green: #34D399;
  --green-bg: rgba(52, 211, 153, 0.14);
  --orange: #FBBF24;
  --orange-bg: rgba(251, 191, 36, 0.14);
  --red: #F87171;
  --red-bg: rgba(248, 113, 113, 0.14);
  --blue: #60A5FA;
  --blue-bg: rgba(96, 165, 250, 0.14);

  /* Message bubble */
  --user-bg-start: #8B7CF7;
  --user-bg-end: #A29BFE;
  --user-text: #FFFFFF;
  --ai-bg: #1A1A26;
  --ai-text: #EDEDF2;

  /* Shadow · 3 tiers with violet tint */
  --shadow-sm: 0 1rpx 2rpx rgba(0, 0, 0, 0.20), 0 2rpx 8rpx rgba(139, 124, 247, 0.05);
  --shadow-md: 0 4rpx 12rpx rgba(0, 0, 0, 0.25), 0 8rpx 24rpx rgba(139, 124, 247, 0.06);
  --shadow-lg: 0 8rpx 24rpx rgba(0, 0, 0, 0.30), 0 16rpx 48rpx rgba(139, 124, 247, 0.10);
  --shadow-glow: 0 0 0 1rpx rgba(139, 124, 247, 0.18), 0 0 24rpx rgba(139, 124, 247, 0.25);

  /* Highlight (inset border for depth) */
  --highlight: inset 0 1rpx 0 rgba(255, 255, 255, 0.04);

  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display",
    "PingFang SC", "Helvetica Neue", "Hiragino Sans GB", "Microsoft YaHei",
    system-ui, sans-serif;
  font-size: 28rpx;
  line-height: 1.65;
  color: var(--text);
  background: var(--bg);
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  letter-spacing: 0.2rpx;
}

/* ── Light theme · 暖灰白 + 微紫调 ── */
.light {
  --bg: #F8F8FB;
  --bg-2: #F1F1F6;
  --surface: #FFFFFF;
  --surface-2: #F4F4F8;
  --surface-3: #E8E8EF;
  --surface-4: #DCDCEC;

  --border: rgba(20, 20, 40, 0.06);
  --border-strong: rgba(20, 20, 40, 0.10);
  --border-focus: rgba(108, 92, 231, 0.45);

  --text: #1A1A2E;
  --text-2: #6B6B85;
  --text-3: #A0A0B5;
  --text-on-accent: #FFFFFF;

  --accent: #6C5CE7;
  --accent-2: #5A4BD1;
  --accent-3: #4A3DC4;
  --accent-glow: rgba(108, 92, 231, 0.28);
  --accent-bg: rgba(108, 92, 231, 0.10);
  --accent-bg-2: rgba(108, 92, 231, 0.05);

  --green: #10B981;
  --green-bg: rgba(16, 185, 129, 0.12);
  --orange: #D97706;
  --orange-bg: rgba(217, 119, 6, 0.12);
  --red: #DC2626;
  --red-bg: rgba(220, 38, 38, 0.12);
  --blue: #2563EB;
  --blue-bg: rgba(37, 99, 235, 0.12);

  --user-bg-start: #6C5CE7;
  --user-bg-end: #7C6CF0;
  --user-text: #FFFFFF;
  --ai-bg: #FFFFFF;
  --ai-text: #1A1A2E;

  --shadow-sm: 0 1rpx 2rpx rgba(20, 20, 40, 0.04), 0 2rpx 8rpx rgba(20, 20, 40, 0.04);
  --shadow-md: 0 4rpx 12rpx rgba(20, 20, 40, 0.06), 0 8rpx 24rpx rgba(108, 92, 231, 0.04);
  --shadow-lg: 0 8rpx 24rpx rgba(20, 20, 40, 0.08), 0 16rpx 48rpx rgba(108, 92, 231, 0.08);
  --shadow-glow: 0 0 0 1rpx rgba(108, 92, 231, 0.20), 0 0 24rpx rgba(108, 92, 231, 0.18);
  --highlight: inset 0 1rpx 0 rgba(255, 255, 255, 0.50);
}

/* ============================================================
 *  Global utilities
 * ============================================================ */
.page { min-height: 100vh; background: var(--bg); }

/* Ambient background · 顶部 radial 光晕增加氛围 */
.page-ambient {
  position: fixed; top: 0; left: 0; right: 0; height: 60vh;
  pointer-events: none; z-index: 0;
  background:
    radial-gradient(ellipse 80% 50% at 20% 0%, var(--accent-bg-2) 0%, transparent 60%),
    radial-gradient(ellipse 60% 40% at 80% 0%, rgba(96, 165, 250, 0.04) 0%, transparent 50%);
}
.light .page-ambient {
  background:
    radial-gradient(ellipse 80% 50% at 20% 0%, rgba(108, 92, 231, 0.05) 0%, transparent 60%),
    radial-gradient(ellipse 60% 40% at 80% 0%, rgba(37, 99, 235, 0.03) 0%, transparent 50%);
}

/* ============================================================
 *  Navbar · 顶部导航
 * ============================================================ */
.navbar {
  display: flex;
  align-items: center;
  padding: var(--s-2) var(--s-3);
  padding-top: calc(var(--s-2) + env(safe-area-inset-top));
  background: transparent;
  position: relative;
  z-index: 10;
}
.nav-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: var(--r-md);
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--surface-2);
  border: 1rpx solid var(--border);
  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  box-shadow: var(--highlight);
}
.nav-btn:active { background: var(--surface-3); transform: scale(0.95); }
.nav-btn-icon { font-size: 36rpx; color: var(--text); font-weight: 300; }
.nav-center { flex: 1; text-align: center; min-width: 0; }
.nav-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text);
  letter-spacing: -0.5rpx;
}
.nav-sub { font-size: 22rpx; color: var(--text-3); margin-top: 2rpx; letter-spacing: 0.5rpx; }
.nav-right { width: 72rpx; height: 72rpx; }

/* ============================================================
 *  Card · 卡片
 * ============================================================ */
.card {
  background: var(--surface);
  border-radius: var(--r-lg);
  margin: 0 var(--s-3);
  border: 1rpx solid var(--border);
  overflow: hidden;
  box-shadow: var(--shadow-sm), var(--highlight);
}
.card-padded { padding: var(--s-3); }

/* ============================================================
 *  List item · 列表项
 * ============================================================ */
.item {
  display: flex;
  align-items: center;
  padding: var(--s-3);
  gap: var(--s-3);
  transition: background 0.18s;
}
.item:active { background: var(--surface-2); }
.item + .item { border-top: 1rpx solid var(--border); }
.item-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: var(--r-md);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  flex-shrink: 0;
  box-shadow: var(--highlight);
}
.item-icon.purple { background: var(--accent-bg); }
.item-icon.green { background: var(--green-bg); }
.item-icon.orange { background: var(--orange-bg); }
.item-icon.blue { background: var(--blue-bg); }
.item-icon.red { background: var(--red-bg); }
.item-body { flex: 1; overflow: hidden; min-width: 0; }
.item-title {
  font-size: 30rpx; font-weight: 600; color: var(--text);
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  letter-spacing: -0.2rpx;
}
.item-desc {
  font-size: 24rpx; color: var(--text-2); margin-top: 4rpx;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  line-height: 1.5;
}
.item-arrow { color: var(--text-3); font-size: 32rpx; font-weight: 300; }

/* ============================================================
 *  Section
 * ============================================================ */
.section { margin-top: var(--s-4); position: relative; z-index: 1; }
.section-label {
  display: block;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--text-3);
  padding: 0 calc(var(--s-3) + 4rpx) var(--s-2);
  letter-spacing: 1.5rpx;
  text-transform: uppercase;
}

/* ============================================================
 *  Field
 * ============================================================ */
.field-row {
  display: flex; align-items: center; padding: var(--s-3); gap: var(--s-2);
}
.field-row + .field-row { border-top: 1rpx solid var(--border); }
.field-label { font-size: 30rpx; color: var(--text); width: 144rpx; flex-shrink: 0; font-weight: 500; }
.field-input {
  flex: 1; font-size: 30rpx; color: var(--text); text-align: right;
  border: none; outline: none; background: transparent;
}
.field-input::placeholder { color: var(--text-3); }

/* ============================================================
 *  Info
 * ============================================================ */
.info-row {
  display: flex; justify-content: space-between; align-items: center;
  padding: var(--s-3); font-size: 30rpx; color: var(--text);
}
.info-row + .info-row { border-top: 1rpx solid var(--border); }
.info-val { color: var(--text-2); font-family: ui-monospace, "SF Mono", Menlo, monospace; font-size: 26rpx; }

/* ============================================================
 *  Status
 * ============================================================ */
.status { display: flex; align-items: center; padding: var(--s-3); gap: var(--s-2); }
.status-dot {
  width: 16rpx; height: 16rpx; border-radius: 50%;
  background: var(--red); flex-shrink: 0;
  box-shadow: 0 0 0 4rpx var(--red-bg);
}
.status-dot.ok { background: var(--green); box-shadow: 0 0 0 4rpx var(--green-bg); }
.status-text { font-size: 30rpx; color: var(--text); flex: 1; font-weight: 500; }
.status-extra {
  font-size: 24rpx; color: var(--text-3); max-width: 320rpx;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  font-family: ui-monospace, "SF Mono", Menlo, monospace;
}

/* ============================================================
 *  Toggle
 * ============================================================ */
.toggle {
  width: 88rpx; height: 52rpx; border-radius: var(--r-full);
  background: var(--surface-3);
  position: relative;
  transition: background 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  border: 1rpx solid var(--border);
}
.toggle.on { background: var(--accent); border-color: var(--accent); }
.toggle::after {
  content: ''; position: absolute; top: 4rpx; left: 4rpx;
  width: 42rpx; height: 42rpx; border-radius: 50%;
  background: #fff;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.20);
  transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
}
.toggle.on::after { transform: translateX(36rpx); }

/* ============================================================
 *  Buttons
 * ============================================================ */
.btn {
  border-radius: var(--r-md);
  padding: var(--s-3);
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 0.3rpx;
  transition: all 0.18s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
  overflow: hidden;
}
.btn-fill {
  background: linear-gradient(135deg, var(--accent) 0%, var(--accent-2) 100%);
  color: var(--text-on-accent);
  box-shadow: var(--shadow-glow);
}
.btn-fill:active { transform: scale(0.98); opacity: 0.92; }
.btn-ghost {
  background: var(--surface-2);
  color: var(--accent);
  border: 1rpx solid var(--border);
}
.btn-ghost:active { background: var(--accent-bg); border-color: var(--accent); }

/* ============================================================
 *  Empty
 * ============================================================ */
.empty {
  display: flex; flex-direction: column; align-items: center;
  justify-content: center; padding: 120rpx var(--s-5); text-align: center;
}
.empty-icon {
  width: 120rpx; height: 120rpx; border-radius: var(--r-lg);
  background: var(--surface-2); display: flex; align-items: center; justify-content: center;
  font-size: 56rpx; margin-bottom: var(--s-3);
  border: 1rpx solid var(--border);
  box-shadow: var(--highlight);
}
.empty-title { font-size: 32rpx; font-weight: 700; color: var(--text); margin-bottom: var(--s-1); letter-spacing: -0.5rpx; }
.empty-desc { font-size: 26rpx; color: var(--text-2); line-height: 1.6; max-width: 480rpx; }

/* ============================================================
 *  Animations
 * ============================================================ */
@keyframes spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }

@keyframes pulse {
  0%, 100% { transform: scale(1); opacity: 1; }
  50% { transform: scale(1.05); opacity: 0.85; }
}

@keyframes shimmer {
  0% { background-position: -200% 0; }
  100% { background-position: 200% 0; }
}

@keyframes fadeInUp {
  from { opacity: 0; transform: translateY(8rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes dotBounce {
  0%, 80%, 100% { transform: scale(0.6); opacity: 0.5; }
  40% { transform: scale(1); opacity: 1; }
}
