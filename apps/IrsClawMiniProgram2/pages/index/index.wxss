.chat-page { display: flex; flex-direction: column; height: 100vh; background: var(--bg); overflow: hidden; }

/* Navbar */
.navbar { display: flex; align-items: center; padding: 16rpx 24rpx; padding-top: calc(16rpx + env(safe-area-inset-top)); background: rgba(20, 20, 25, 0.85); backdrop-filter: blur(24rpx); -webkit-backdrop-filter: blur(24rpx); border-bottom: 1rpx solid var(--border); flex-shrink: 0; z-index: 10; }
.nav-btn { width: 72rpx; height: 72rpx; border-radius: 20rpx; display: flex; align-items: center; justify-content: center; }
.nav-btn:active { background: var(--surface-2); }
.nav-btn-icon { font-size: 36rpx; color: var(--text); }
.nav-center { flex: 1; text-align: center; }
.nav-title { font-size: 34rpx; font-weight: 700; color: var(--text); }

/* Scroll */
.messages-scroll { flex: 1; overflow: hidden; }
.msg-bottom-anchor { height: 24rpx; }

/* Empty */
.empty-state { display: flex; flex-direction: column; align-items: center; padding: 160rpx 60rpx 80rpx; text-align: center; min-height: 70vh; }
.empty-logo { width: 120rpx; height: 120rpx; border-radius: 36rpx; background: linear-gradient(135deg, #6C5CE7, #A29BFE); display: flex; align-items: center; justify-content: center; margin-bottom: 36rpx; box-shadow: 0 8rpx 32rpx rgba(108, 92, 231, 0.3); }
.empty-logo-text { font-size: 44rpx; font-weight: 700; color: #fff; }
.empty-title { font-size: 38rpx; font-weight: 700; color: var(--text); margin-bottom: 12rpx; }
.empty-desc { font-size: 28rpx; color: var(--text-2); margin-bottom: 60rpx; }
.suggestions { display: flex; flex-wrap: wrap; gap: 20rpx; justify-content: center; max-width: 600rpx; }
.suggest-btn { padding: 18rpx 32rpx; background: var(--surface); border: 1rpx solid var(--border); border-radius: 40rpx; }
.suggest-btn:active { background: var(--accent-bg); border-color: var(--accent); }
.suggest-text { font-size: 26rpx; color: var(--text-2); }

/* Message List */
.message-list { padding: 24rpx 24rpx 0; }
.msg-row { display: flex; align-items: flex-start; margin-bottom: 24rpx; gap: 16rpx; }
.msg-row-user { flex-direction: row-reverse; }
.msg-row-ai { flex-direction: row; }

/* Avatar */
.avatar { width: 72rpx; height: 72rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0; margin-top: 4rpx; }
.avatar-user { background: linear-gradient(135deg, #6C5CE7, #8B7CF7); }
.avatar-ai { background: linear-gradient(135deg, #6C5CE7, #74B9FF); }
.avatar-tool { background: linear-gradient(135deg, #FFB347, #FF6B6B); }
.avatar-text { font-size: 24rpx; font-weight: 700; color: #fff; }

/* Message Content */
.msg-content { max-width: 560rpx; min-width: 80rpx; }
.msg-content-user { display: flex; flex-direction: column; align-items: flex-end; }
.msg-content-ai { display: flex; flex-direction: column; align-items: flex-start; }

/* Bubbles */
.msg-bubble { padding: 20rpx 28rpx; word-break: break-word; }
.msg-bubble-user { background: linear-gradient(135deg, #6C5CE7, #7C6CF7); border-radius: 24rpx 8rpx 24rpx 24rpx; box-shadow: 0 4rpx 20rpx rgba(108, 92, 231, 0.25); }
.msg-bubble-ai { background: var(--ai-bg); border: 1rpx solid var(--border); border-radius: 8rpx 24rpx 24rpx 24rpx; }
.msg-text { font-size: 30rpx; line-height: 1.7; }
.msg-text-user { color: #fff; }
.msg-text-ai { color: var(--ai-text); }

/* ===== Thinking Card (reasoning only, no content) ===== */
.thinking-card { background: var(--surface); border: 1rpx solid rgba(108, 92, 231, 0.2); border-radius: 20rpx; overflow: hidden; }
.thinking-header { display: flex; align-items: center; padding: 20rpx 24rpx; gap: 12rpx; background: var(--accent-bg); }
.thinking-icon-wrap { width: 40rpx; height: 40rpx; border-radius: 50%; background: var(--accent-bg); display: flex; align-items: center; justify-content: center; }
.thinking-icon { font-size: 24rpx; color: var(--accent); }
.thinking-label { font-size: 26rpx; font-weight: 600; color: var(--accent); flex: 1; }
.thinking-toggle { font-size: 22rpx; color: var(--text-3); padding: 4rpx 16rpx; background: var(--surface-2); border-radius: 8rpx; }
.thinking-body { padding: 20rpx 24rpx; border-top: 1rpx solid var(--border); }
.thinking-text { font-size: 26rpx; color: var(--text-2); line-height: 1.7; white-space: pre-wrap; }

/* ===== Tool Call Card ===== */
.tool-card { background: var(--surface); border: 1rpx solid var(--border); border-radius: 20rpx; overflow: hidden; }
.tool-card:active { background: var(--surface-2); }
.tool-header { display: flex; align-items: center; padding: 20rpx 24rpx; gap: 12rpx; }
.tool-icon-wrap { width: 48rpx; height: 48rpx; border-radius: 12rpx; background: var(--orange-bg); display: flex; align-items: center; justify-content: center; }
.tool-icon-text { font-size: 26rpx; }
.tool-info { flex: 1; }
.tool-name { font-size: 28rpx; font-weight: 600; color: var(--text); }
.tool-badge { padding: 4rpx 16rpx; border-radius: 20rpx; }
.tool-badge-done { background: var(--green-bg); }
.tool-badge-running { background: var(--orange-bg); }
.tool-badge-text { font-size: 22rpx; font-weight: 500; }
.tool-badge-done .tool-badge-text { color: var(--green); }
.tool-badge-running .tool-badge-text { color: var(--orange); }
.tool-body { padding: 20rpx 24rpx; border-top: 1rpx solid var(--border); }
.tool-section { margin-bottom: 16rpx; }
.tool-section:last-child { margin-bottom: 0; }
.tool-section-label { font-size: 22rpx; color: var(--text-3); font-weight: 600; display: block; margin-bottom: 8rpx; }
.tool-code-wrap { background: var(--bg); border-radius: 12rpx; padding: 16rpx 20rpx; }
.tool-code { font-size: 24rpx; color: var(--text-2); line-height: 1.6; white-space: pre-wrap; word-break: break-all; }

/* ===== Reasoning Fold (in AI message with content) ===== */
.reasoning-fold { background: var(--surface); border: 1rpx solid rgba(255, 179, 71, 0.15); border-radius: 16rpx; margin-bottom: 16rpx; overflow: hidden; }
.reasoning-fold-header { display: flex; align-items: center; padding: 16rpx 20rpx; gap: 10rpx; background: var(--orange-bg); }
.reasoning-fold-icon { font-size: 24rpx; color: var(--orange); }
.reasoning-fold-label { font-size: 24rpx; font-weight: 600; color: var(--orange); flex: 1; }
.reasoning-fold-toggle { font-size: 20rpx; color: var(--text-3); padding: 2rpx 12rpx; background: var(--surface-2); border-radius: 6rpx; }
.reasoning-fold-body { padding: 16rpx 20rpx; border-top: 1rpx solid var(--border); }
.reasoning-fold-text { font-size: 24rpx; color: var(--text-2); line-height: 1.7; white-space: pre-wrap; }

/* Thinking Dots */
.thinking-dots { display: flex; align-items: center; gap: 12rpx; padding: 24rpx 28rpx; background: var(--ai-bg); border: 1rpx solid var(--border); border-radius: 8rpx 24rpx 24rpx 24rpx; }
.dot { width: 16rpx; height: 16rpx; border-radius: 50%; background: var(--text-3); animation: dotBounce 1.4s ease-in-out infinite both; }
.dot-1 { animation-delay: 0s; }
.dot-2 { animation-delay: 0.16s; }
.dot-3 { animation-delay: 0.32s; }
@keyframes dotBounce { 0%, 80%, 100% { transform: scale(0.6); opacity: 0.4; } 40% { transform: scale(1); opacity: 1; } }

/* Connection */
.conn-bar { display: flex; align-items: center; justify-content: center; padding: 12rpx 24rpx; gap: 12rpx; background: var(--red-bg); flex-shrink: 0; }
.conn-dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: var(--red); }
.conn-text { font-size: 24rpx; color: var(--red); font-weight: 500; }

/* Floating Input */
.float-input-area { flex-shrink: 0; background: transparent; }
.float-input-bar { display: flex; align-items: flex-end; padding: 12rpx 24rpx; gap: 16rpx; background: var(--surface); border-top: 1rpx solid var(--border); }
.float-input-wrap { flex: 1; background: var(--surface-2); border: 2rpx solid var(--border); border-radius: 40rpx; padding: 12rpx 24rpx; transition: all 0.25s; min-height: 80rpx; display: flex; align-items: center; }
.float-input-focus { border-color: var(--accent); box-shadow: 0 0 0 6rpx rgba(108, 92, 231, 0.12); background: var(--surface); }
.float-textarea { width: 100%; font-size: 30rpx; color: var(--text); line-height: 1.6; min-height: 48rpx; max-height: 240rpx; background: transparent; }
.float-ph { color: var(--text-3); font-size: 30rpx; }
.float-send { width: 80rpx; height: 80rpx; border-radius: 50%; background: var(--surface-3); display: flex; align-items: center; justify-content: center; flex-shrink: 0; transition: all 0.2s; }
.float-send-on { background: var(--accent); box-shadow: 0 6rpx 24rpx rgba(108, 92, 231, 0.4); }
.float-send-on:active { transform: scale(0.9); }
.float-send-icon { font-size: 36rpx; font-weight: 700; color: var(--text-3); transition: color 0.2s; }
.float-send-on .float-send-icon { color: #fff; }

/* Sidebar */
.sidebar-mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.6); z-index: 100; opacity: 0; visibility: hidden; transition: all 0.3s; }
.sidebar-mask-show { opacity: 1; visibility: visible; }
.sidebar { position: fixed; top: 0; left: 0; bottom: 0; width: 560rpx; background: var(--surface); z-index: 101; transform: translateX(-100%); transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1); display: flex; flex-direction: column; border-right: 1rpx solid var(--border); }
.sidebar-open { transform: translateX(0); }
.sidebar-header { display: flex; align-items: center; gap: 20rpx; padding: 48rpx 36rpx 36rpx; padding-top: calc(48rpx + env(safe-area-inset-top)); border-bottom: 1rpx solid var(--border); }
.sidebar-logo { width: 80rpx; height: 80rpx; border-radius: 24rpx; background: linear-gradient(135deg, #6C5CE7, #A29BFE); display: flex; align-items: center; justify-content: center; box-shadow: 0 4rpx 16rpx rgba(108, 92, 231, 0.3); }
.sidebar-logo-text { font-size: 32rpx; font-weight: 700; color: #fff; }
.sidebar-title { font-size: 36rpx; font-weight: 700; color: var(--text); }
.sidebar-nav { flex: 1; padding: 16rpx 0; overflow-y: auto; }
.sidebar-item { display: flex; align-items: center; padding: 28rpx 36rpx; gap: 24rpx; }
.sidebar-item:active { background: var(--surface-2); }
.sidebar-item-icon { font-size: 36rpx; width: 48rpx; text-align: center; }
.sidebar-item-text { font-size: 30rpx; font-weight: 500; color: var(--text); }
.sidebar-divider { height: 1rpx; background: var(--border); margin: 8rpx 36rpx; }
.sidebar-footer { padding: 24rpx 36rpx; padding-bottom: calc(24rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid var(--border); }
.sidebar-conn { display: flex; align-items: center; gap: 12rpx; }
.sidebar-conn-dot { width: 14rpx; height: 14rpx; border-radius: 50%; background: var(--red); }
.sidebar-conn-dot-ok { background: var(--green); }
.sidebar-conn-text { font-size: 24rpx; color: var(--text-3); }