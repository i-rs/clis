<view class="page">
  <view class="navbar">
    <view class="nav-btn" bindtap="goBack">
      <text>←</text>
    </view>
    <view class="nav-center">
      <text class="nav-title">Agent</text>
    </view>
    <view class="nav-right"></view>
  </view>

  <view wx:if="{{agents.length > 0}}">
    <view class="card" style="margin-top: 24rpx;">
      <view class="item" wx:for="{{agents}}" wx:key="id" bindtap="onSwitchAgent" data-id="{{item.id}}">
        <view class="item-icon purple">
          <text>👤</text>
        </view>
        <view class="item-body">
          <text class="item-title">{{item.id}}</text>
          <text class="item-desc">{{item.model || ''}}</text>
        </view>
        <view class="agent-current" wx:if="{{item.id === currentAgent}}"></view>
      </view>
    </view>
  </view>

  <view class="empty" wx:if="{{loaded && agents.length === 0}}">
    <view class="empty-icon">👤</view>
    <text class="empty-title">暂无 Agent</text>
    <text class="empty-desc">连接服务器后，可用 Agent 将显示在这里</text>
  </view>
</view>
