<view class="page">
  <view class="navbar">
    <view class="nav-btn" bindtap="goBack">
      <text>←</text>
    </view>
    <view class="nav-center">
      <text class="nav-title">技能</text>
    </view>
    <view class="nav-right"></view>
  </view>

  <view wx:if="{{skills.length > 0}}">
    <view class="card" style="margin-top: 24rpx;">
      <view class="item" wx:for="{{skills}}" wx:key="name">
        <view class="item-icon green">
          <text>📖</text>
        </view>
        <view class="item-body">
          <text class="item-title">{{item.name}}</text>
          <text class="item-desc">{{item.description || ''}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="empty" wx:if="{{loaded && skills.length === 0}}">
    <view class="empty-icon">📖</view>
    <text class="empty-title">暂无技能</text>
    <text class="empty-desc">连接服务器后，可用技能将显示在这里</text>
  </view>
</view>
